# The numbers below `n`, each modulo 1000, written out parted by commas:
# each written, then the first piece taken and the rest folded onto it, a
# comma before each, as `List.join` was once written.
package {}

import std.host {Host}

listed : Nat -> Str
listed(n) -> joined(List.range(n).map(|i| "${i % 1000}"), ",")

joined : (List(Str), Str) -> Str
joined([], _) -> ""
joined([first, *rest], separator) -> rest.fold(first, |text, piece| text.concat(separator).concat(piece))

digest : Str -> Nat
digest(text) -> text.to_utf8().fold(0, |h, byte| (h * 31 + byte.to_nat()) % 1000003)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  text = listed(n)
  printed = host.println!("${text.len()} ${digest(text)}")
  host.exit!(0)
)
