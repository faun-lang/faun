# Three words of nine bytes each, in three-byte thirds: the second starts
# with the first's middle third, the third with the first's last, and the
# second ends with the third's middle. A third cannot cut a UTF-8 character.
# The words come one to a line; each square found goes out as a line.
#
# The loops are `flat_map`, and a sorted set's `from` finds each prefix.

import std.host {Host}

main! : Host -> []
main!(host) -> (
  read = host.stdin.lines!()
  words = SortedSet.of_list(read.ok_or([]).map(|line| line.trim()))
  said = host.print_lines!(squares(words))
  host.exit!(0)
)

squares : SortedSet(Str) -> List(Str)
squares(words) -> words.to_list().flat_map(|first|
  if thirds(first) is Ok((middle, last)) then
    starting(words, last).flat_map(|third|
      if thirds(third) is Ok((third_middle, _)) then
        starting(words, middle)
          .filter(|second| second.len() == 9 & second.ends_with(third_middle))
          .map(|second| "${first},${second},${third}")
      else [])
  else [])

# The middle and last thirds, only when both cuts leave valid text.
thirds : Str -> Result((Str, Str), [NotNineBytes, InvalidUtf8])
thirds(word) if word.len() != 9 -> Err(NotNineBytes)
thirds(word) -> (
  bytes = word.to_utf8()
  middle = Str.from_utf8(bytes.drop(3).take(3))?
  last = Str.from_utf8(bytes.drop(6))?
  Ok((middle, last))
)

# The words that start with `prefix`, which a sorted set holds together.
starting : (SortedSet(Str), Str) -> List(Str)
starting(words, prefix) -> words.from(prefix).take_while(|word| word.starts_with(prefix))

expect squares(SortedSet.of_list(["abcdefghi", "defxyzjkl", "ghijklmno"])) == ["abcdefghi,defxyzjkl,ghijklmno"]
expect squares(SortedSet.of_list(["abcdefghi", "defxyzzzz", "ghijklmno"])) == []
expect squares(SortedSet.of_list(["a"])) == []
expect squares(SortedSet.of_list(["abcéxdé", "éxmnoghi", "déghijkl"])) == ["abcéxdé,éxmnoghi,déghijkl"]
expect thirds("abécdefg") == Err(InvalidUtf8)
