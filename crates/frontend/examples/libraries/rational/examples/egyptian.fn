# Egyptian fractions, observed from outside: a fraction between nought and
# one written as a sum of distinct unit fractions, greedily, Fibonacci's
# way, each the largest unit fraction no greater than what is left.

package {
  uses: {
    rational: "../src/rational"
  }
}

import rational {Rational}

# The denominators of the unit fractions summing to `r`, smallest first.
egyptian : Rational -> List(Nat)
egyptian(r) if r <= Rational.zero -> []
egyptian(r) -> (
  unit = Nat.from_int(r.recip().ceil()).ok_or(1)
  [unit, *egyptian(r - Rational.of_nat(unit).recip())]
)

expect egyptian(Rational.of_parts(4, 13)) == [4, 18, 468]
expect egyptian(Rational.of_parts(5, 121)) == [25, 757, 763309, 873960180913, 1527612795642093418846225]
expect egyptian(Rational.of_parts(1, 7)) == [7] & egyptian(Rational.zero) == []
expect egyptian(Rational.of_parts(5, 121)).fold(Rational.zero, |sum, d| sum + Rational.of_nat(d).recip()) == Rational.of_parts(5, 121)
