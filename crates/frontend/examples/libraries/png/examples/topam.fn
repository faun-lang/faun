# Decodes a PNG file on standard input and writes its pixels to standard
# output as a PAM file (Netpbm's P7) of 8-bit red, green, blue and alpha,
# which most image tools read, whatever colour the PNG file stores. A file refused says why on standard error,
# with status one.

package {
  uses: {
    png: "../src/png"
  }
}

import std.host {Host}
import png {decode, Image}

main! : Host -> []
main!(host) -> (
  read = host.stdin.read_to_end!()
  read is Ok(input) else return host.exit!(1)
  decoded = decode(input)
  decoded is Ok(image) else return (
    written = host.stderr.write_all!("png: ${decoded}\n".to_utf8())
    host.exit!(1)
  )
  wrote = host.stdout.write_all!(pam(image.to_rgba()))
  host.exit!(if wrote.is_ok() then 0 else 1)
)

# An image of red, green, blue and alpha as a PAM file: its header, then
# its pixels as they are.
pam : Image -> List(U8)
pam(image) ->
  "P7\nWIDTH ${image.width()}\nHEIGHT ${image.height()}\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n".to_utf8().concat(image.pixels())

expect Image.from_pixels(1, 1, Rgba, [1, 2, 3, 4]).map_ok(|image| pam(image).drop(65)) == Ok([1, 2, 3, 4])
