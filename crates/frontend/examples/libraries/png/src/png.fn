# PNG decoding and encoding (the W3C PNG specification, third edition).
#
# An `Image` is a width, a height, a colour and its pixels, 8 bits a
# sample, which `Image.from_pixels` checks agree before it makes one, so
# every image there is can be encoded. `encode` writes one as a PNG file
# and `decode` reads one back as it was.
#
# Decoding reads every colour type at every bit depth PNG allows, with or
# without Adam7 interlacing. Each pixel comes back in the colour nearest
# the file's: a palette's entries as red, green and blue, with alpha where
# tRNS gives any; tRNS's key as an alpha channel; a 16-bit sample as its
# high byte, as libpng's `png_set_strip_16` does; and a sample of fewer
# than 8 bits scaled to the full range, so 1-bit white is 255. Corrupt or
# cut-short input answers `Err` naming why; nothing panics or reads past
# the end.
#
# Every chunk's CRC-32 is checked. The image data is every IDAT joined
# and inflated through the flate library's zlib reader; each row is then
# unfiltered into one list holding every pass's rows, which the pixels are
# read from. Ancillary chunks other than tRNS, such as gamma and colour
# space, are skipped: the samples come back as the file holds them.
#
# Encoding writes 8-bit samples in the image's own colour, without
# interlacing. Each row is filtered as libpng chooses, by the smallest sum
# of its bytes taken as signed, unless one filter is asked for, and the
# rows are compressed through the flate library's deflate.
#
# Written in the most natural Faun spelling: where that runs slowly, the
# compiler has a bug to fix, and notes/compression.md lists them.

package {
  uses: {
    crc: "../../crc/src/crc",
    flate: "../../flate/src/flate"
  }
}

import crc {Crc32, crc32, adler32}
import flate {zlib_decompress, zlib_compress, Level, InflateError}

export {
  Image, Color, ImageError, decode, read_info, Info, ColorType, PngError,
  encode, encode_with, Options, Filter, Level, InflateError
}

# What each pixel of an image holds, in order, a byte each: grey; grey and
# alpha; red, green and blue; or red, green, blue and alpha. Alpha is
# opacity, 0 transparent and 255 opaque.
Color = [Grey, GreyAlpha, Rgb, Rgba]

# The bytes a pixel of `color` takes.
channels : Color -> Nat
channels(Grey) -> 1
channels(GreyAlpha) -> 2
channels(Rgb) -> 3
channels(Rgba) -> 4

# The widest side PNG allows, 2^31 - 1.
widest : Nat
widest = 0x7fffffff

# Why `Image.from_pixels` refused an image.
ImageError = [
  # A side is nought: PNG has no empty image.
  ZeroSize,
  # A side is wider than PNG allows, 2^31 - 1.
  TooLarge,
  # The pixels are not `width * height` times the bytes a pixel of the
  # colour takes: `expected` bytes, and `found` were given.
  WrongLength({expected: Nat, found: Nat}),
]

# An image: its width and height in pixels, its colour, and its pixels,
# rows top to bottom and each left to right, `channels` bytes a pixel.
# The four can never disagree: `from_pixels` checks them, and `decode`
# makes only images that agree.
Image : {width: Nat, height: Nat, color: Color, pixels: List(U8)}.(
  # The image `width` by `height` of `color` whose pixels are `pixels`,
  # or why there is none.
  from_pixels : (Nat, Nat, Color, List(U8)) -> Result(Image, ImageError)
  from_pixels(width, height, color, pixels) -> (
    if width == 0 | height == 0 return Err(ZeroSize)
    if width > widest | height > widest return Err(TooLarge)
    expected = width * height * channels(color)
    if pixels.len() != expected return Err(WrongLength({expected, found: pixels.len()}))
    Ok(Image({width, height, color, pixels}))
  )
  expect Image.from_pixels(2, 1, Rgb, [255, 0, 0, 0, 0, 255]).map_ok(Image.width) == Ok(2)
  expect Image.from_pixels(2, 1, Rgb, [255, 0, 0]) == Err(WrongLength({expected: 6, found: 3}))
  expect Image.from_pixels(0, 1, Grey, []) == Err(ZeroSize)

  # How many pixels wide the image is.
  width : Image -> Nat
  width(Image(image)) -> image.width
  expect Image.from_pixels(3, 1, Grey, [0, 1, 2]).map_ok(Image.width) == Ok(3)

  # How many pixels high the image is.
  height : Image -> Nat
  height(Image(image)) -> image.height
  expect Image.from_pixels(1, 2, Grey, [0, 1]).map_ok(Image.height) == Ok(2)

  # What each pixel holds.
  color : Image -> Color
  color(Image(image)) -> image.color
  expect Image.from_pixels(1, 1, GreyAlpha, [9, 255]).map_ok(Image.color) == Ok(GreyAlpha)

  # Every pixel, rows top to bottom and each left to right, its channels
  # in the order its colour names them.
  pixels : Image -> List(U8)
  pixels(Image(image)) -> image.pixels
  expect Image.from_pixels(2, 1, Grey, [7, 8]).map_ok(Image.pixels) == Ok([7, 8])

  # The pixel in column `x` of row `y`, counting from nought at the top
  # left, as its channels.
  pixel : (Image, Nat, Nat) -> Result(List(U8), [OutOfBounds])
  pixel(Image(image), x, y) -> (
    if x >= image.width | y >= image.height return Err(OutOfBounds)
    per = channels(image.color)
    Ok(image.pixels.drop((y * image.width + x) * per).take(per))
  )
  expect Image.from_pixels(2, 1, Rgb, [1, 2, 3, 4, 5, 6]).map_ok(|image| image.pixel(1, 0)) == Ok(Ok([4, 5, 6]))
  expect Image.from_pixels(2, 1, Rgb, [1, 2, 3, 4, 5, 6]).map_ok(|image| image.pixel(2, 0)) == Ok(Err(OutOfBounds))

  # The same image as red, green, blue and alpha: grey spread to all three
  # colours, and alpha 255 where there was none.
  to_rgba : Image -> Image
  to_rgba(Image(image)) -> Image({color: Rgba, pixels: rgba_of(image.pixels, image.color, []), *image})
  expect Image.from_pixels(1, 1, GreyAlpha, [9, 128]).map_ok(|image| image.to_rgba().pixels()) == Ok([9, 9, 9, 128])
  expect Image.from_pixels(1, 1, Rgb, [1, 2, 3]).map_ok(|image| image.to_rgba().pixels()) == Ok([1, 2, 3, 255])

  # The same image in the fewest channels that hold it exactly: grey where
  # every pixel's red, green and blue agree, and alpha only where some
  # pixel is not opaque. Its file is smaller, and decodes to this image.
  reduced : Image -> Image
  reduced(image) -> (
    Image(rgba) = image.to_rgba()
    color = fewest(rgba.pixels, {grey: True, opaque: True})
    Image({color, pixels: rgba_to(rgba.pixels, color, []), *rgba})
  )
  expect Image.from_pixels(2, 1, Rgba, [5, 5, 5, 255, 6, 6, 6, 255]).map_ok(|image| image.reduced().pixels()) == Ok([5, 6])
  expect Image.from_pixels(1, 1, Rgba, [1, 2, 3, 255]).map_ok(|image| image.reduced().color()) == Ok(Rgb)
  expect Image.from_pixels(1, 1, Rgb, [4, 4, 4]).map_ok(|image| image.reduced().color()) == Ok(Grey)

  # Whether two images are the same size and colour, with the same pixels.
  equals : (Image, Image) -> Bool

  # The image written out, its pixels and all, as a record is.
  to_str : Image -> Str
)

expect Image.from_pixels(1, 1, Grey, [3]) == Image.from_pixels(1, 1, Grey, [3])
expect Image.from_pixels(1, 1, Grey, [3]) != Image.from_pixels(1, 1, Grey, [4])
expect Image.from_pixels(1, 1, Grey, [3]).map_ok(Image.to_str) == Ok("{color: Grey, height: 1, pixels: [3], width: 1}")

# Pixels of `color` as red, green, blue and alpha, appended to `out`.
rgba_of : (List(U8), Color, List(U8)) -> List(U8)
rgba_of(pixels, Rgba, _) -> pixels
rgba_of([red, green, blue, *rest], Rgb, out) -> rgba_of(rest, Rgb, out.append(red).append(green).append(blue).append(255))
rgba_of([level, alpha, *rest], GreyAlpha, out) -> rgba_of(rest, GreyAlpha, out.append(level).append(level).append(level).append(alpha))
rgba_of([level, *rest], Grey, out) -> rgba_of(rest, Grey, out.append(level).append(level).append(level).append(255))
rgba_of(_, _, out) -> out

# Pixels of red, green, blue and alpha as `color`'s channels, appended to
# `out`: grey keeps the red, and a colour without alpha drops it.
rgba_to : (List(U8), Color, List(U8)) -> List(U8)
rgba_to(pixels, Rgba, _) -> pixels
rgba_to([red, green, blue, _, *rest], Rgb, out) -> rgba_to(rest, Rgb, out.append(red).append(green).append(blue))
rgba_to([red, _, _, alpha, *rest], GreyAlpha, out) -> rgba_to(rest, GreyAlpha, out.append(red).append(alpha))
rgba_to([red, _, _, _, *rest], Grey, out) -> rgba_to(rest, Grey, out.append(red))
rgba_to(_, _, out) -> out

# The colour that holds every pixel of red, green, blue and alpha exactly,
# given whether every pixel so far is grey and whether every one is
# opaque.
fewest : (List(U8), {grey: Bool, opaque: Bool}) -> Color
fewest(_, {grey: False, opaque: False}) -> Rgba
fewest([red, green, blue, alpha, *rest], {grey, opaque}) ->
  fewest(rest, {grey: grey & red == green & green == blue, opaque: opaque & alpha == 255})
fewest(_, {grey: True, opaque: True}) -> Grey
fewest(_, {grey: True, opaque: False}) -> GreyAlpha
fewest(_, {grey: False, opaque: True}) -> Rgb

# --- Decoding ---

# How a PNG file stores its samples: PNG's five colour types. `Indexed`
# is a palette's: each pixel an index into a table of colours.
ColorType = [Grey, GreyAlpha, Rgb, Rgba, Indexed]

# What a PNG file's header says: its size; how it stores its samples, in a
# colour type and a depth, the bits a sample, which is 1, 2, 4, 8 or 16 as
# the colour type allows; and whether its rows are Adam7 interlaced.
Info = {width: Nat, height: Nat, color_type: ColorType, depth: Nat, interlaced: Bool}

# Every way a file can be refused.
PngError = [
  # The first eight bytes are not PNG's signature.
  NotPng,
  # The file ends before a chunk or the image data does.
  Truncated,
  # A chunk's CRC-32 is not its type's and data's.
  ChecksumMismatch,
  # IHDR is missing or not first, or gives a size, colour type, bit depth,
  # compression, filter or interlace method PNG does not have.
  BadHeader,
  # A chunk the decoder must understand, its type capitalised, is not one
  # it knows. It holds the chunk's type.
  UnknownCriticalChunk(Str),
  # A palette image has no PLTE, or a PLTE is longer than 256 entries or
  # not whole entries.
  BadPalette,
  # A tRNS is longer than its image allows.
  BadTransparency,
  # There is no IDAT, or no IEND.
  MissingData,
  # The image data is not a zlib stream: it holds why inflating it failed.
  BadImageData(InflateError),
  # A row's filter type is above 4.
  BadFilter,
  # The image data inflates to fewer bytes than its rows need.
  ShortData,
]

signature : List(U8)
signature = [0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a]

# The image a PNG file holds, or why it cannot be read.
decode : List(U8) -> Result(Image, PngError)
decode(file) -> (
  (info, after) = read_header(file)?
  parts = chunks(file, after, {palette: [], transparency: [], data: [], seen_data: False})?
  if !parts.seen_data return Err(MissingData)
  format = format_of(info, parts.palette, parts.transparency)?
  data = zlib_decompress(parts.data).map_err(BadImageData)?
  passes = layout(info)
  raw = unfilter_passes(data, passes, bits_per_pixel(info), 0, [])?
  pixels = if info.interlaced then interlaced_pixels(raw, info, passes, format)
    else straight_pixels(raw, info, format)
  Ok(Image({width: info.width, height: info.height, color: format.color, pixels}))
)
expect decode([]) == Err(NotPng)
expect decode(signature) == Err(Truncated)

# What a PNG file's header says, its signature and IHDR read and checked,
# without decoding the rest.
read_info : List(U8) -> Result(Info, PngError)
read_info(file) -> (
  (info, _) = read_header(file)?
  Ok(info)
)
expect read_info(built(ihdr(2, 1, 2), [[0, 1, 2, 3, 4, 5, 6]]))
  == Ok({width: 2, height: 1, color_type: Rgb, depth: 8, interlaced: False})

# The header, and where the chunk after IHDR starts.
read_header : List(U8) -> Result((Info, Nat), PngError)
read_header(file) -> (
  if file.take(8) != signature return Err(NotPng)
  chunk = read_chunk(file, 8)?
  if chunk.kind != "IHDR" | chunk.length != 13 return Err(BadHeader)
  at = chunk.start
  width = big_endian(file, at)
  height = big_endian(file, at + 4)
  depth = byte(file, at + 8)
  color_type = color_type_of(byte(file, at + 9))?
  interlace = byte(file, at + 12)
  if width == 0 | height == 0 | width > widest | height > widest return Err(BadHeader)
  if !allowed_depth(color_type, depth) return Err(BadHeader)
  # Compression, filtering and interlacing each have one or two methods.
  if byte(file, at + 10) != 0 | byte(file, at + 11) != 0 | interlace > 1 return Err(BadHeader)
  Ok(({width, height, color_type, depth, interlaced: interlace == 1}, chunk.next))
)

# The colour type IHDR's number names.
color_type_of : Nat -> Result(ColorType, PngError)
color_type_of(0) -> Ok(Grey)
color_type_of(2) -> Ok(Rgb)
color_type_of(3) -> Ok(Indexed)
color_type_of(4) -> Ok(GreyAlpha)
color_type_of(6) -> Ok(Rgba)
color_type_of(_) -> Err(BadHeader)

# The number IHDR gives the colour type that stores `color`.
color_code : Color -> U8
color_code(Grey) -> 0
color_code(Rgb) -> 2
color_code(GreyAlpha) -> 4
color_code(Rgba) -> 6

allowed_depth : (ColorType, Nat) -> Bool
allowed_depth(Grey, depth) -> depth == 1 | depth == 2 | depth == 4 | depth == 8 | depth == 16
allowed_depth(Indexed, depth) -> depth == 1 | depth == 2 | depth == 4 | depth == 8
allowed_depth(_, depth) -> depth == 8 | depth == 16

# A chunk: its type, where its data starts and how long it is, and where
# the next chunk starts. Its CRC-32 is checked here.
Chunk = {kind: Str, start: Nat, length: Nat, next: Nat}

read_chunk : (List(U8), Nat) -> Result(Chunk, PngError)
read_chunk(file, at) -> (
  if at + 12 > file.len() return Err(Truncated)
  length = big_endian(file, at)
  start = at + 8
  next = start + length + 4
  if next > file.len() return Err(Truncated)
  kind = Str.from_ascii(file.drop(at + 4).take(4)).ok_or("")
  checked = Crc32.empty.update(file.drop(at + 4).take(length + 4)).value()
  if checked.to_nat() != big_endian(file, start + length) return Err(ChecksumMismatch)
  Ok({kind, start, length, next})
)

# What the chunks after IHDR give: the palette and transparency as they
# stand, and every IDAT's data joined.
Parts = {palette: List(U8), transparency: List(U8), data: List(U8), seen_data: Bool}

chunks : (List(U8), Nat, Parts) -> Result(Parts, PngError)
chunks(file, at, parts) -> (
  chunk = read_chunk(file, at)?
  body = file.drop(chunk.start).take(chunk.length)
  next = chunk.next
  chunk.kind is (
    "IEND" then Ok(parts)
    "IDAT" then chunks(file, next, {data: parts.data.concat(body), seen_data: True, *parts})
    "PLTE" then chunks(file, next, {palette: body, *parts})
    "tRNS" then chunks(file, next, {transparency: body, *parts})
    "IHDR" then Err(BadHeader)
    # A capital first letter marks a chunk no decoder may skip.
    _ then if file.get(at + 4).ok_or(0).is_ascii_upper() then Err(UnknownCriticalChunk(chunk.kind))
      else chunks(file, next, parts)
  )
)

# How a pixel's samples become the image's: the file's colour type and
# depth, the colour they become, the palette as four bytes an entry for
# every index a byte can hold, and the samples tRNS marks transparent.
Format = {color_type: ColorType, depth: Nat, color: Color, palette: List(U8), key: List(Nat)}

format_of : (Info, List(U8), List(U8)) -> Result(Format, PngError)
format_of(info, palette, transparency) -> (
  entries = palette.len() / 3
  if palette.len() % 3 != 0 | entries > 256 return Err(BadPalette)
  if info.color_type == Indexed & entries == 0 return Err(BadPalette)
  key = info.color_type is (
    Grey then if transparency.len() >= 2 then [big_endian2(transparency, 0)] else []
    Rgb then if transparency.len() >= 6 then [big_endian2(transparency, 0), big_endian2(transparency, 2), big_endian2(transparency, 4)] else []
    _ then []
  )
  if info.color_type == Indexed & transparency.len() > entries return Err(BadTransparency)
  # An index past the palette reads as opaque black, as libpng reads it.
  table = List.range(256).flat_map(|index| if index < entries then [
    palette.get(index * 3).ok_or(0),
    palette.get(index * 3 + 1).ok_or(0),
    palette.get(index * 3 + 2).ok_or(0),
    transparency.get(index).ok_or(255),
  ] else [0, 0, 0, 255])
  # tRNS gives an image without alpha an alpha channel.
  color = info.color_type is (
    Grey then if key == [] then Grey else GreyAlpha
    Rgb then if key == [] then Rgb else Rgba
    Indexed then if transparency == [] then Rgb else Rgba
    GreyAlpha then GreyAlpha
    Rgba then Rgba
  )
  Ok({color_type: info.color_type, depth: info.depth, color, palette: table, key})
)

# The samples a pixel of a colour type has.
samples : ColorType -> Nat
samples(Grey) -> 1
samples(Indexed) -> 1
samples(GreyAlpha) -> 2
samples(Rgb) -> 3
samples(Rgba) -> 4

bits_per_pixel : Info -> Nat
bits_per_pixel(info) -> samples(info.color_type) * info.depth

# A pass of the image: the pixels from column `x` and row `y` on, every
# `dx` and `dy`, and how many columns and rows it has. A straight image is
# one pass of every pixel; Adam7 is seven.
Pass = {x: Nat, y: Nat, dx: Nat, dy: Nat, columns: Nat, rows: Nat}

layout : Info -> List(Pass)
layout(info) -> (
  starts = if info.interlaced then [
    (0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4), (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2),
  ] else [(0, 0, 1, 1)]
  starts.map(|(x, y, dx, dy)| {
    x, y, dx, dy,
    columns: span(info.width, x, dx),
    rows: span(info.height, y, dy),
  })
)

# How many of `size` positions from `start` on, every `step`.
span : (Nat, Nat, Nat) -> Nat
span(size, start, step) -> if size > start then (size - start + step - 1) / step else 0

# Every pass's rows unfiltered, one after another, each without its filter
# byte. A pass with no columns or rows has no data at all.
unfilter_passes : (List(U8), List(Pass), Nat, Nat, List(U8)) -> Result(List(U8), PngError)
unfilter_passes(_, [], _, _, raw) -> Ok(raw)
unfilter_passes(data, [pass, *rest], bits, at, raw) -> (
  if pass.columns == 0 | pass.rows == 0 return unfilter_passes(data, rest, bits, at, raw)
  stride = (pass.columns * bits + 7) / 8
  # The bytes back to the same sample of the pixel before, at least one.
  back = (bits + 7) / 8
  if at + pass.rows * (stride + 1) > data.len() return Err(ShortData)
  done = List.range(pass.rows).try_fold(raw, |raw, y| (
    start = at + y * (stride + 1)
    filter = byte(data, start)
    if filter > 4 then Err(BadFilter) else Ok(unfilter_row(data.drop(start + 1).take(stride), raw, stride, back, y == 0, filter))
  ))?
  unfilter_passes(data, rest, bits, at + pass.rows * (stride + 1), done)
)

# One row's bytes reconstructed and appended to `raw`, whose last
# `stride` bytes are the row before, unless this is a pass's first row.
# Each filter adds to a byte some of `a`, the byte `back` before it in
# this row, `b`, the one above, and `c`, the one above `a`, each nought
# where there is none. A filter is chosen once a row, so the walk for
# each knows which of them it needs; on a first row, where `b` and `c`
# are nought, Up is None and Paeth is Sub.
unfilter_row : (List(U8), List(U8), Nat, Nat, Bool, Nat) -> List(U8)
unfilter_row(row, raw, _, _, True, 0) -> raw.concat(row)
unfilter_row(row, raw, _, _, True, 2) -> raw.concat(row)
unfilter_row(row, raw, _, back, True, 1) -> sub(row.drop(back), raw.concat(row.take(back)), back)
unfilter_row(row, raw, _, back, True, 4) -> sub(row.drop(back), raw.concat(row.take(back)), back)
unfilter_row(row, raw, _, back, True, _) -> average_first(row.drop(back), raw.concat(row.take(back)), back)
unfilter_row(row, raw, _, _, False, 0) -> raw.concat(row)
unfilter_row(row, raw, _, back, False, 1) -> sub(row.drop(back), raw.concat(row.take(back)), back)
unfilter_row(row, raw, stride, _, False, 2) -> raw.concat(List.map2(row, raw.drop(raw.len() - stride), |x, b| x + b))
unfilter_row(row, raw, stride, back, False, 3) -> average(row, raw, raw.len() - stride, back, 0)
unfilter_row(row, raw, stride, back, False, _) -> paeth_row(row, raw, raw.len() - stride, back, 0)

# Each byte plus `a`.
sub : (List(U8), List(U8), Nat) -> List(U8)
sub([], raw, _) -> raw
sub([x, *rest], raw, back) -> sub(rest, raw.append(x + raw.get(raw.len() - back).ok_or(0)), back)

# Each byte plus half of `a`, on a first row.
average_first : (List(U8), List(U8), Nat) -> List(U8)
average_first([], raw, _) -> raw
average_first([x, *rest], raw, back) ->
  average_first(rest, raw.append(x + (raw.get(raw.len() - back).ok_or(0) >> 1)), back)

# Each byte plus the mean of `a` and `b`, rounded down; `column` counts to
# `back`, before which there is no `a`.
average : (List(U8), List(U8), Nat, Nat, Nat) -> List(U8)
average([], raw, _, _, _) -> raw
average([x, *rest], raw, above, back, column) -> (
  b = raw.get(above).ok_or(0).to_nat()
  a = if column >= back then raw.get(raw.len() - back).ok_or(0).to_nat() else 0
  average(rest, raw.append(x + U8.of_nat((a + b) / 2)), above + 1, back, column + 1)
)

paeth_row : (List(U8), List(U8), Nat, Nat, Nat) -> List(U8)
paeth_row([], raw, _, _, _) -> raw
paeth_row([x, *rest], raw, above, back, column) -> (
  b = raw.get(above).ok_or(0)
  predicted = if column < back then b else paeth(raw.get(raw.len() - back).ok_or(0), b, raw.get(above - back).ok_or(0))
  paeth_row(rest, raw.append(x + predicted), above + 1, back, column + 1)
)

# Whichever of `a`, `b` and `c` is nearest `a + b - c`, ties going in
# that order: the distances are `b`'s from `c`, `a`'s from `c`, and
# `a + b`'s from twice `c`, so nothing goes below nought.
paeth : (U8, U8, U8) -> U8
paeth(a, b, c) -> (
  (x, y, z) = (a.to_nat(), b.to_nat(), c.to_nat())
  pa = distance(y, z)
  pb = distance(x, z)
  pc = distance(x + y, z * 2)
  if pa <= pb & pa <= pc then a else if pb <= pc then b else c
)
expect paeth(10, 20, 15) == 15 & paeth(10, 20, 5) == 20 & paeth(10, 20, 30) == 10

distance : (Nat, Nat) -> Nat
distance(x, y) -> if x > y then x - y else y - x

# A straight image's pixels, row by row. Its rows hold no filter bytes
# by now, so an image of 8-bit samples that tRNS adds nothing to is its
# pixels already, and a palette's indices are looked up one by one.
straight_pixels : (List(U8), Info, Format) -> List(U8)
straight_pixels(raw, _, {depth: 8, color_type: Indexed, palette, color, *}) -> indexed(raw, palette, color, [])
straight_pixels(raw, _, {depth: 8, key: [], *}) -> raw
straight_pixels(raw, info, format) -> (
  stride = (info.width * bits_per_pixel(info) + 7) / 8
  List.range(info.height).fold([], |out, y| List.range(info.width).fold(out, |out, column|
    appended(out, format.color, color_at(raw, y * stride, column, format))))
)

# Each index's palette entry, as `color`, red, green and blue with alpha
# or without.
indexed : (List(U8), List(U8), Color, List(U8)) -> List(U8)
indexed([index, *rest], palette, color, out) -> (
  at = index.to_nat() * 4
  entry = out.append(palette.get(at).ok_or(0)).append(palette.get(at + 1).ok_or(0)).append(palette.get(at + 2).ok_or(0))
  indexed(rest, palette, color, if color == Rgba then entry.append(palette.get(at + 3).ok_or(0)) else entry)
)
indexed(_, _, _, out) -> out

# A pixel's red, green, blue and alpha appended to `out` as `color`'s
# channels.
appended : (List(U8), Color, (U8, U8, U8, U8)) -> List(U8)
appended(out, Grey, (level, _, _, _)) -> out.append(level)
appended(out, GreyAlpha, (level, _, _, alpha)) -> out.append(level).append(alpha)
appended(out, Rgb, (red, green, blue, _)) -> out.append(red).append(green).append(blue)
appended(out, Rgba, (red, green, blue, alpha)) -> out.append(red).append(green).append(blue).append(alpha)

# An interlaced image's pixels: every pass's pixels written where they
# fall in the whole image, which starts as nought and is written in place.
interlaced_pixels : (List(U8), Info, List(Pass), Format) -> List(U8)
interlaced_pixels(raw, info, passes, format) -> (
  whole = List.repeat(0, info.width * info.height * channels(format.color))
  scatter_passes(raw, passes, bits_per_pixel(info), info.width, format, 0, whole)
)

scatter_passes : (List(U8), List(Pass), Nat, Nat, Format, Nat, List(U8)) -> List(U8)
scatter_passes(_, [], _, _, _, _, out) -> out
scatter_passes(raw, [pass, *rest], bits, width, format, at, out) -> (
  if pass.columns == 0 | pass.rows == 0 return scatter_passes(raw, rest, bits, width, format, at, out)
  stride = (pass.columns * bits + 7) / 8
  per = channels(format.color)
  done = List.range(pass.rows).fold(out, |out, y| List.range(pass.columns).fold(out, |out, column| (
    target = ((pass.y + y * pass.dy) * width + pass.x + column * pass.dx) * per
    written(out, target, format.color, color_at(raw, at + y * stride, column, format))
  )))
  scatter_passes(raw, rest, bits, width, format, at + pass.rows * stride, done)
)

# A pixel's red, green, blue and alpha written at `at` as `color`'s
# channels.
written : (List(U8), Nat, Color, (U8, U8, U8, U8)) -> List(U8)
written(out, at, Grey, (level, _, _, _)) -> out.put(at, level)
written(out, at, GreyAlpha, (level, _, _, alpha)) -> out.put(at, level).put(at + 1, alpha)
written(out, at, Rgb, (red, green, blue, _)) -> out.put(at, red).put(at + 1, green).put(at + 2, blue)
written(out, at, Rgba, (red, green, blue, alpha)) -> out.put(at, red).put(at + 1, green).put(at + 2, blue).put(at + 3, alpha)

# The pixel at `column` of the row starting at `row`, as red, green,
# blue and alpha.
color_at : (List(U8), Nat, Nat, Format) -> (U8, U8, U8, U8)
color_at(raw, row, column, format) -> format.color_type is (
  Grey then (
    grey = sample(raw, row, column, format.depth)
    level = scaled(grey, format.depth)
    (level, level, level, if format.key == [grey] then 0 else 255)
  )
  Rgb then (
    red = sample(raw, row, column * 3, format.depth)
    green = sample(raw, row, column * 3 + 1, format.depth)
    blue = sample(raw, row, column * 3 + 2, format.depth)
    hidden = format.key == [red, green, blue]
    (scaled(red, format.depth), scaled(green, format.depth), scaled(blue, format.depth), if hidden then 0 else 255)
  )
  Indexed then (
    entry = sample(raw, row, column, format.depth) * 4
    palette = format.palette
    (palette.get(entry).ok_or(0), palette.get(entry + 1).ok_or(0), palette.get(entry + 2).ok_or(0), palette.get(entry + 3).ok_or(0))
  )
  GreyAlpha then (
    level = scaled(sample(raw, row, column * 2, format.depth), format.depth)
    (level, level, level, scaled(sample(raw, row, column * 2 + 1, format.depth), format.depth))
  )
  Rgba then (
    scaled(sample(raw, row, column * 4, format.depth), format.depth),
    scaled(sample(raw, row, column * 4 + 1, format.depth), format.depth),
    scaled(sample(raw, row, column * 4 + 2, format.depth), format.depth),
    scaled(sample(raw, row, column * 4 + 3, format.depth), format.depth),
  )
)

# The `index`th sample of the row starting at `row`, as many bits as
# `depth`, the first sample in a byte its most significant bits.
sample : (List(U8), Nat, Nat, Nat) -> Nat
sample(raw, row, index, 8) -> byte(raw, row + index)
sample(raw, row, index, 16) -> big_endian2(raw, row + index * 2)
sample(raw, row, index, depth) -> (
  bit = index * depth
  (byte(raw, row + bit / 8) >> (8 - depth - bit % 8)) & ((1 << depth) - 1)
)
expect sample([0b10110100], 0, 1, 2) == 3 & sample([0b10110100], 0, 3, 2) == 0 & sample([0x12, 0x34], 0, 0, 16) == 0x1234

# A sample as eight bits: a 16-bit one's high byte, and a narrower one
# scaled so its largest value is 255.
scaled : (Nat, Nat) -> U8
scaled(value, 16) -> U8.of_nat(value >> 8)
scaled(value, 8) -> U8.of_nat(value)
scaled(value, 4) -> U8.of_nat(value * 17)
scaled(value, 2) -> U8.of_nat(value * 85)
scaled(value, _) -> U8.of_nat(value * 255)
expect scaled(1, 1) == 255 & scaled(2, 2) == 170 & scaled(0xabcd, 16) == 0xab

byte : (List(U8), Nat) -> Nat
byte(file, at) -> file.get(at).ok_or(0).to_nat()

big_endian2 : (List(U8), Nat) -> Nat
big_endian2(file, at) -> (byte(file, at) << 8) | byte(file, at + 1)

big_endian : (List(U8), Nat) -> Nat
big_endian(file, at) -> (big_endian2(file, at) << 16) | big_endian2(file, at + 2)

# A PNG file built for the expectations below: its chunks with their
# CRC-32s, and its image data, `rows` with their filter bytes, as one
# stored block of a zlib stream.
built : (List(U8), List(List(U8))) -> List(U8)
built(header, rows) -> (
  data = rows.flatten()
  length = data.len()
  stream = [0x78, 0x01, 1, U8.of_nat(length), U8.of_nat(length >> 8), !U8.of_nat(length), !U8.of_nat(length >> 8)]
    .concat(data).concat(word(adler32(data).to_nat()))
  signature.concat(chunk("IHDR", header)).concat(chunk("IDAT", stream)).concat(chunk("IEND", []))
)

# The header of an 8-bit image `width` by `height` of colour type number
# `code`.
ihdr : (Nat, Nat, U8) -> List(U8)
ihdr(width, height, code) -> word(width).concat(word(height)).concat([8, code, 0, 0, 0])

# The colour and pixels a file decodes to.
decoded : List(U8) -> Result((Color, List(U8)), PngError)
decoded(file) -> decode(file).map_ok(|image| (image.color(), image.pixels()))

expect decoded(built(ihdr(2, 1, 2), [[0, 1, 2, 3, 4, 5, 6]])) == Ok((Rgb, [1, 2, 3, 4, 5, 6]))

# Sub adds the pixel to the left; Up the row above; Average half of
# both; Paeth the nearer.
expect decoded(built(ihdr(2, 1, 2), [[1, 1, 2, 3, 4, 5, 6]])) == Ok((Rgb, [1, 2, 3, 5, 7, 9]))
expect decoded(built(ihdr(1, 2, 0), [[0, 10], [2, 5]])) == Ok((Grey, [10, 15]))
expect decoded(built(ihdr(2, 2, 0), [[0, 10, 20], [3, 1, 1]])) == Ok((Grey, [10, 20, 6, 14]))
expect decoded(built(ihdr(2, 2, 0), [[0, 10, 20], [4, 1, 1]])) == Ok((Grey, [10, 20, 11, 21]))

# A palette becomes red, green and blue, and alpha where tRNS gives any;
# tRNS's key becomes an alpha channel.
expect (
  header = ihdr(2, 1, 3)
  palette = chunk("PLTE", [10, 20, 30, 40, 50, 60])
  plain = built(header, [[0, 1, 0]])
  with_palette = plain.take(33).concat(palette).concat(plain.drop(33))
  see_through = plain.take(33).concat(palette).concat(chunk("tRNS", [128])).concat(plain.drop(33))
  decoded(with_palette) == Ok((Rgb, [40, 50, 60, 10, 20, 30]))
    & decoded(see_through) == Ok((Rgba, [40, 50, 60, 255, 10, 20, 30, 128]))
)
expect (
  plain = built(ihdr(2, 1, 0), [[0, 7, 9]])
  keyed = plain.take(33).concat(chunk("tRNS", [0, 9])).concat(plain.drop(33))
  decoded(keyed) == Ok((GreyAlpha, [7, 255, 9, 0]))
)

expect decode(built(ihdr(1, 1, 0), [[5, 0]])) == Err(BadFilter)
expect decode(built(ihdr(2, 2, 0), [[0, 1, 2]])) == Err(ShortData)
expect decode(built(ihdr(1, 1, 3), [[0, 0]])) == Err(BadPalette)
expect decode(built(word(1).concat(word(1)).concat([8, 1, 0, 0, 0]), [[0, 0]])) == Err(BadHeader)
expect decode(built(word(1).concat(word(1)).concat([3, 0, 0, 0, 0]), [[0, 0]])) == Err(BadHeader)
# Image data that is no zlib stream says why: a block of type 3.
expect (
  file = signature.concat(chunk("IHDR", ihdr(1, 1, 0))).concat(chunk("IDAT", [0x78, 0x01, 7])).concat(chunk("IEND", []))
  decode(file) == Err(BadImageData(BadBlockType))
)

# A chunk no decoder may skip, and a CRC-32 a bit off.
expect (
  file = built(ihdr(1, 1, 0), [[0, 0]])
  decode(file.take(33).concat(chunk("QQQQ", [])).concat(file.drop(33))) == Err(UnknownCriticalChunk("QQQQ"))
    & decode(file.take(33).concat(chunk("qqQQ", [1])).concat(file.drop(33))).is_ok()
    & decode(file.put(32, file.get(32).ok_or(0) ^ 1)) == Err(ChecksumMismatch)
)

# --- Encoding ---

# How each row is filtered before it is compressed: each of PNG's five
# filters predicts a byte from its neighbours and stores what is left.
# `Adaptive` tries all five on each row and keeps the one whose bytes,
# taken as signed, sum smallest, as libpng does; it suits photographs and
# gradients. `Unfiltered` stores every row as it is, which is fastest and
# suits images of few colours. The other four use one filter throughout.
Filter = [Adaptive, Unfiltered, Sub, Up, Average, Paeth]

# How to encode an image: how hard deflate looks for matches, and how each
# row is filtered.
Options = {level: Level, filter: Filter}

# `image` as a PNG file, compressed at zlib's default level with each row
# filtered adaptively. `decode` reads it back as `image`.
encode : Image -> List(U8)
encode(image) -> encode_with(image, {level: Level.default, filter: Adaptive})
expect Image.from_pixels(2, 1, Rgb, [255, 0, 0, 0, 0, 255]).map_ok(|image| decode(encode(image)) == Ok(image)) == Ok(True)

# `image` as a PNG file, compressed and filtered as `options` say.
# `decode` reads it back as `image`, however it was written.
encode_with : (Image, Options) -> List(U8)
encode_with(Image({width, height, color, pixels}), {level, filter}) -> (
  per = channels(color)
  rows = filtered(pixels, width * per, per, filter)
  header = word(width).concat(word(height)).concat([8, color_code(color), 0, 0, 0])
  data = zlib_compress(rows, level)
  signature.concat(chunk("IHDR", header)).concat(data_chunks(data, [])).concat(chunk("IEND", []))
)
expect Image.from_pixels(2, 1, Grey, [0, 255])
  .map_ok(|image| decode(encode_with(image, {level: Level.best, filter: Paeth})) == Ok(image)) == Ok(True)

# Every row with its filter byte before it. `per` is the bytes a pixel,
# and so how far back the byte to the left is.
#
# A row is walked as four lists side by side: the row's bytes `x`, the
# bytes `a` to their left, those above them, `b`, and those above `a`, `c`.
# Before the first row, and left of the first pixel, there are noughts.
filtered : (List(U8), Nat, Nat, Filter) -> List(U8)
filtered(pixels, stride, per, filter) ->
  filter_rows(pixels, List.repeat(0, stride), stride, per, filter, pixels.len() / stride, [])

filter_rows : (List(U8), List(U8), Nat, Nat, Filter, Nat, List(U8)) -> List(U8)
filter_rows(_, _, _, _, _, 0, out) -> out
filter_rows(pixels, above, stride, per, filter, Succ(rows), out) -> (
  row = pixels.take(stride)
  left = List.repeat(0, per).concat(row)
  above_left = List.repeat(0, per).concat(above)
  kind = filter is (
    Adaptive then best_filter(row, left, above, above_left)
    Unfiltered then 0
    Sub then 1
    Up then 2
    Average then 3
    Paeth then 4
  )
  done = residuals(row, left, above, above_left, kind, out.append(U8.of_nat(kind)))
  filter_rows(pixels.drop(stride), row, stride, per, filter, rows, done)
)

# The filter whose row of residuals, each taken as signed, sums smallest,
# ties going to the lower filter. Every filter is scored in one walk, which
# reads each byte and its neighbours once.
best_filter : (List(U8), List(U8), List(U8), List(U8)) -> Nat
best_filter(row, left, above, above_left) -> (
  (none, sub_sum, up, average_sum, paeth_sum) = costs(row, left, above, above_left, (0, 0, 0, 0, 0))
  [(none, 0), (sub_sum, 1), (up, 2), (average_sum, 3), (paeth_sum, 4)].min().map_ok(|(_, kind)| kind).ok_or(0)
)

Costs = (Nat, Nat, Nat, Nat, Nat)

costs : (List(U8), List(U8), List(U8), List(U8), Costs) -> Costs
costs([x, *xs], [a, *rest_a], [b, *rest_b], [c, *rest_c], (none, sub_sum, up, average_sum, paeth_sum)) ->
  costs(xs, rest_a, rest_b, rest_c, (
    none + signed(x),
    sub_sum + signed(x - a),
    up + signed(x - b),
    average_sum + signed(x - mean(a, b)),
    paeth_sum + signed(x - paeth(a, b, c)),
  ))
costs(_, _, _, _, sums) -> sums

# Each byte of `x` less what filter `kind` predicts of it, appended to
# `out`.
residuals : (List(U8), List(U8), List(U8), List(U8), Nat, List(U8)) -> List(U8)
residuals([x, *xs], [a, *rest_a], [b, *rest_b], [c, *rest_c], kind, out) ->
  residuals(xs, rest_a, rest_b, rest_c, kind, out.append(x - predicted(a, b, c, kind)))
residuals(_, _, _, _, _, out) -> out

predicted : (U8, U8, U8, Nat) -> U8
predicted(_, _, _, 0) -> 0
predicted(a, _, _, 1) -> a
predicted(_, b, _, 2) -> b
predicted(a, b, _, 3) -> mean(a, b)
predicted(a, b, c, _) -> paeth(a, b, c)

# The mean of `a` and `b`, rounded down.
mean : (U8, U8) -> U8
mean(a, b) -> U8.of_nat((a.to_nat() + b.to_nat()) / 2)

# A byte's distance from nought, taken as signed.
signed : U8 -> Nat
signed(value) -> (
  n = value.to_nat()
  n.min(256 - n)
)

# The zlib stream in IDAT chunks of at most 65536 bytes. One chunk would
# do, up to 2^31 - 1 bytes, but a reader that streams holds a chunk whole
# to check its CRC-32 before using it, and 64 KB is what Pillow writes;
# the 12 bytes each chunk adds are a fraction of a percent.
data_chunks : (List(U8), List(U8)) -> List(U8)
data_chunks([], out) -> out
data_chunks(data, out) -> data_chunks(data.drop(65536), out.concat(chunk("IDAT", data.take(65536))))

# A chunk: its length, its type and body, and their CRC-32.
chunk : (Str, List(U8)) -> List(U8)
chunk(kind, body) -> (
  typed = kind.to_utf8().concat(body)
  word(body.len()).concat(typed).concat(word(crc32(typed).to_nat()))
)

# `n`'s low 32 bits, most significant first.
word : Nat -> List(U8)
word(n) -> [U8.of_nat(n >> 24), U8.of_nat(n >> 16), U8.of_nat(n >> 8), U8.of_nat(n)]

# Every colour round-trips through its own colour type, at every level
# and with every filter.
expect (
  images = [
    Image.from_pixels(3, 2, Rgba, [1, 2, 3, 255, 4, 5, 6, 255, 7, 8, 9, 128, 10, 11, 12, 0, 9, 9, 9, 9, 200, 100, 50, 25]),
    Image.from_pixels(3, 2, Rgb, [1, 2, 3, 4, 5, 6, 7, 8, 9, 200, 100, 50, 0, 0, 0, 255, 255, 255]),
    Image.from_pixels(2, 2, Grey, [5, 6, 7, 250]),
    Image.from_pixels(1, 2, GreyAlpha, [5, 0, 6, 9]),
  ]
  codes = [6, 2, 0, 4]
  filters = [Adaptive, Unfiltered, Sub, Up, Average, Paeth]
  List.map2(images, codes, |image, code| image.map_ok(|image| (
    file = encode(image)
    file.get(25) == Ok(code)
      & [Level.none, Level.fastest, Level.best].all(|level| filters.all(|filter|
        decode(encode_with(image, {level, filter})) == Ok(image)))
  )) == Ok(True)).all(|held| held)
)

# A reduced image's file decodes to the reduced image, as to_rgba of it
# gives the original back.
expect (
  image = Image.from_pixels(2, 1, Rgba, [9, 9, 9, 255, 3, 3, 3, 255])
  image.map_ok(|i| (
    small = i.reduced()
    decode(encode(small)) == Ok(small) & small.color() == Grey & small.to_rgba() == i
  )) == Ok(True)
)
