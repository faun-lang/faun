# A piece: a side's piece of a kind. Every side and kind make a legal
# piece, so its constructor is public: `Piece(White, Knight)` is a white
# knight.

import color {Color.*}
import role {Role.*, role_letter, role_of_letter}

export {Piece.*, piece_letter, piece_of_letter}

# A piece: its side and its role.
Piece : [Piece(Color, Role)].(
  # The piece's side.
  color : Piece -> Color
  color(Piece(color, _)) -> color
  expect Piece(Black, Rook).color() == Black

  # The piece's role.
  role : Piece -> Role
  role(Piece(_, role)) -> role
  expect Piece(Black, Rook).role() == Rook

  equals : (Piece, Piece) -> Bool
  to_str : Piece -> Str
)

# The piece's letter in FEN: a capital for White, a small letter for
# Black.
piece_letter : Piece -> U8
piece_letter(Piece(White, role)) -> role_letter(role).to_ascii_upper()
piece_letter(Piece(Black, role)) -> role_letter(role)
expect piece_letter(Piece(White, Knight)) == 'N'
expect piece_letter(Piece(Black, Knight)) == 'n'

# The piece a FEN letter names: a capital for White, a small letter for
# Black.
piece_of_letter : U8 -> Result(Piece, [Malformed])
piece_of_letter(letter) -> (
  role = role_of_letter(letter)?
  Ok(Piece(if letter.is_ascii_upper() then White else Black, role))
)
expect piece_of_letter('k') == Ok(Piece(Black, King))
expect piece_of_letter('P') == Ok(Piece(White, Pawn))
expect piece_of_letter('1') == Err(Malformed)
