# Chess for Faun: squares, pieces and positions, positions read from and
# written as FEN, every legal move of a position, castling, en passant and
# promotion among them, moves read from and written as UCI, and perft, the
# count of the move paths to a depth that checks a move generator.
#
# A `Position` is the whole state of a game at one moment. Its
# `legal_moves` are `Move`s, plain data, and `play` checks a move is legal
# before playing it, wherever the move came from; `play_unchecked` plays a
# move `legal_moves` just gave without asking again. Every type is sealed
# where a value could be wrong: a `Square` is always on the board, and a
# `Position` always one a game can reach.
#
# Written in the most natural Faun spelling, a list of 64 squares and
# every candidate move played and tested: where that runs slowly, the
# compiler has a bug to fix.

package {}

import file {File}
import rank {Rank}
import square {Square}
import direction {Direction.*}
import color {Color.*}
import role {Role.*}
import piece {Piece.*}
import castling_side {CastlingSide.*}
import castling_rights {CastlingRights}
import move {Move, MoveKind.*}
import position {Position, FenError}

export {
  File,
  Rank,
  Square,
  Direction.*,
  Color.*,
  Role.*,
  Piece.*,
  CastlingSide.*,
  CastlingRights,
  Position,
  Move,
  MoveKind.*,
  FenError,
  perft,
  divide,
}

# How many paths of `depth` legal moves lead on from `position`: the
# number perft tables give, which checks a move generator, since every
# legal move must be found once and no other. Each move `legal_moves`
# gives is played unchecked, and the last level's are only counted.
perft : (Position, Nat) -> Nat
perft(_, 0) -> 1
perft(position, 1) -> position.legal_moves().len()
perft(position, Succ(depth)) -> position.legal_moves().map(|move| perft(position.play_unchecked(move), depth)).sum()
expect perft(Position.start, 1) == 20
expect perft(Position.start, 2) == 400
expect perft(Position.start, 0) == 1

# Each legal move from `position`, by its UCI, and the perft of `depth`
# less one from where it leads: what a perft to `depth` sums, so two move
# generators that disagree can be followed to the move they first differ
# on. `depth` 0 is taken as 1.
divide : (Position, Nat) -> List((Move, Nat))
divide(position, depth) -> position.legal_moves().map(|move| (move, perft(position.play_unchecked(move), depth - 1)))
expect divide(Position.start, 2).map(|(_, count)| count).sum() == 400
expect divide(Position.start, 1).all(|(_, count)| count == 1)

# The positions of the Chess Programming Wiki's perft results, and their
# counts at depths small enough to ask here on the reference interpreter;
# the tests in crates/cli/tests/chess.rs ask the deeper ones of the
# example built for the machine.
kiwipete : Str
kiwipete = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1"

positions : List((Str, List(Nat)))
positions = [
  (kiwipete, [48]),
  ("8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1", [14, 191]),
  ("r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1", [6, 264]),
  ("rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8", [44]),
  ("r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10", [46]),
]

expect positions.all(|(fen, counts)| Position.from_fen(fen) is Ok(position)
  & counts.enumerate().all(|(n, count)| perft(position, n + 1) == count))

# The FEN of the position after the move UCI's `uci` writes, from the
# position `fen` writes.
after_uci : (Str, Str) -> Result(Str, _)
after_uci(fen, uci) -> (
  position = Position.from_fen(fen)?
  move = position.move_from_uci(uci)?
  Ok(position.play(move)?.to_fen())
)

# Every FEN read back is written as it was read.
expect positions.all(|(fen, _)| Position.from_fen(fen).map_ok(Position.to_fen) == Ok(fen))

# Castling: both sides at once, the rook going with the king, and the
# rights of a king that has moved gone.
expect after_uci(kiwipete, "e1c1") == Ok("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/2KR3R b kq - 1 1")
expect Position.from_fen(kiwipete).and_then(|position| position.move_from_uci("e1c1").err_as(InvalidBoard)).map_ok(Move.kind) == Ok(Castle(QueenSide))

# A castle through an attacked square is not legal, though the squares
# between are empty: the bishop on f1 is gone and a rook covers it.
expect (
  open = Position.from_fen("4kr2/8/8/8/8/8/8/4K2R w K - 0 1")
  open is Ok(position) & position.move_from_uci("e1g1") == Err(NoLegalMove)
)

# En passant, and the en passant capture that would leave the king
# attacked along its rank, which is not legal.
expect after_uci("4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 2", "e5d6") == Ok("4k3/8/3P4/8/8/8/8/4K3 b - - 0 2")
expect (
  pinned = Position.from_fen("8/8/8/K2pP2r/8/8/8/7k w - d6 0 2")
  pinned is Ok(position) & position.move_from_uci("e5d6") == Err(NoLegalMove)
)

# Promotion, to each role, taking or not.
expect (
  promoting = Position.from_fen("3r3k/4P3/8/8/8/8/8/K7 w - - 0 1")
  promoting is Ok(position)
    & position.legal_moves().filter(|move| move.promotion().is_ok()).map(Move.to_uci)
      == ["e7e8q", "e7e8r", "e7e8b", "e7e8n", "e7d8q", "e7d8r", "e7d8b", "e7d8n"]
)
expect after_uci("3r3k/4P3/8/8/8/8/8/K7 w - - 0 1", "e7d8n") == Ok("3N3k/8/8/8/8/8/8/K7 b - - 0 1")

# A pinned piece may move only along its pin.
expect (
  pinned = Position.from_fen("4k3/4r3/8/8/8/8/4R3/4K3 w - - 0 1")
  pinned is Ok(position)
    & position.legal_moves().filter(|move| move.role() == Rook).map(Move.to_uci)
      == ["e2e3", "e2e4", "e2e5", "e2e6", "e2e7"]
)

# A move is legal wherever a position has it: `e2e4` from the start plays
# on another position with a pawn on `e2`, and is refused, holding the
# move, where that pawn is blocked.
expect (
  e4 = Position.start.move_from_uci("e2e4")
  stuck = Position.from_fen("4k3/8/8/8/8/8/4P3/4K3 w - - 0 1")
  (e4, stuck) is (Ok(move), Ok(position)) & position.play(move) == Ok(position.play_unchecked(move))
)
expect (
  e4 = Position.start.move_from_uci("e2e4")
  blocked = Position.from_fen("4k3/8/8/8/4p3/8/4P3/4K3 w - - 0 1")
  (e4, blocked) is (Ok(move), Ok(position)) & position.play(move) == Err(IllegalMove(move))
)
