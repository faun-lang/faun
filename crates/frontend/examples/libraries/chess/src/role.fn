# The six kinds of piece, whichever side they are.

export {Role.*, promotions, role_letter, role_of_letter}

# A kind of piece, as shakmaty calls it, whichever side it is.
Role : [Pawn, Knight, Bishop, Rook, Queen, King].(
  equals : (Role, Role) -> Bool
  to_str : Role -> Str
)

# What a pawn may become on the last rank, the strongest first.
promotions : List(Role)
promotions = [Queen, Rook, Bishop, Knight]
expect promotions.len() == 4

# The role's small letter, as UCI writes a promotion and FEN a black
# piece: `p`, `n`, `b`, `r`, `q` or `k`.
role_letter : Role -> U8
role_letter(Pawn) -> 'p'
role_letter(Knight) -> 'n'
role_letter(Bishop) -> 'b'
role_letter(Rook) -> 'r'
role_letter(Queen) -> 'q'
role_letter(King) -> 'k'
expect [Pawn, Knight, Bishop, Rook, Queen, King].map(role_letter) == ['p', 'n', 'b', 'r', 'q', 'k']

# The role a letter names, in either case.
role_of_letter : U8 -> Result(Role, [Malformed])
role_of_letter(letter) -> letter.to_ascii_lower() is (
  'p' then Ok(Pawn)
  'n' then Ok(Knight)
  'b' then Ok(Bishop)
  'r' then Ok(Rook)
  'q' then Ok(Queen)
  'k' then Ok(King)
  _ then Err(Malformed)
)
expect role_of_letter('Q') == Ok(Queen)
expect role_of_letter('x') == Err(Malformed)
