# The board's 64 squares. The library's root exports `Square` sealed, so
# outside it a square is always on the board: one made from coordinates
# or from text is checked once, where it is made, and never again.

export {Square.*}

# A square of the board: `a1` is 0, `b1` 1, and so on along each rank up
# to `h8`, 63, as shakmaty and cozy-chess number them.
Square : Nat.(
  # The square on file `file` and rank `rank`, each counted from nought:
  # `a1` is `(0, 0)` and `h8` `(7, 7)`.
  from_coords : (Nat, Nat) -> Result(Square, [OutOfRange])
  from_coords(file, rank) if file < 8 & rank < 8 -> Ok(Square(rank * 8 + file))
  from_coords(_, _) -> Err(OutOfRange)
  expect Square.from_coords(4, 3).map_ok(Square.to_str) == Ok("e4")
  expect Square.from_coords(8, 0) == Err(OutOfRange)

  # The square's file, counted from nought: 0 for the `a` file, 7 for the
  # `h` file.
  file : Square -> Nat
  file(Square(n)) -> n % 8
  expect Square.from_str("e4").map_ok(Square.file) == Ok(4)

  # The square's rank, counted from nought: 0 for the first rank, 7 for the
  # eighth.
  rank : Square -> Nat
  rank(Square(n)) -> n / 8
  expect Square.from_str("e4").map_ok(Square.rank) == Ok(3)

  # The square a name such as `e4` gives: a file's letter, then a rank's
  # digit.
  from_str : Str -> Result(Square, [Malformed])
  from_str(text) -> text.to_utf8() is (
    [letter, digit] if letter >= 'a' & letter <= 'h' & digit >= '1' & digit <= '8' then
      Ok(Square((digit - '1').to_nat() * 8 + (letter - 'a').to_nat()))
    _ then Err(Malformed)
  )
  expect Square.from_str("h8") == Square.from_coords(7, 7).err_as(Malformed)
  expect Square.from_str("i1") == Err(Malformed)
  expect Square.from_str("e44") == Err(Malformed)

  # The square's name, as `e4`.
  to_str : Square -> Str
  to_str(Square(n)) -> Str.from_ascii(['a' + U8.of_nat(n % 8), '1' + U8.of_nat(n / 8)]).ok_or("")
  expect Square.from_coords(0, 0).map_ok(Square.to_str) == Ok("a1")

  equals : (Square, Square) -> Bool
)
