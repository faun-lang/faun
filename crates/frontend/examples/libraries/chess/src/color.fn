# The two sides.

export {Color.*, color_letter, color_of_letter}

# A side: White, who moves first, or Black.
Color : [White, Black].(
  # The other side.
  other : Color -> Color
  other(White) -> Black
  other(Black) -> White
  expect White.other() == Black
  expect Black.other() == White

  equals : (Color, Color) -> Bool
  to_str : Color -> Str
)

# The side's letter in FEN, `w` or `b`.
color_letter : Color -> U8
color_letter(White) -> 'w'
color_letter(Black) -> 'b'
expect color_letter(Black) == 'b'

# The side a FEN letter names, `w` or `b`.
color_of_letter : U8 -> Result(Color, [Malformed])
color_of_letter('w') -> Ok(White)
color_of_letter('b') -> Ok(Black)
color_of_letter(_) -> Err(Malformed)
expect color_of_letter('w') == Ok(White)
expect color_of_letter('x') == Err(Malformed)
