# A move, as cozy-chess has it: the square a piece leaves, the square it
# lands on, and what a pawn becomes, if it does. Which piece moves, what
# it takes, and whether the move castles or takes in passing are the
# position's to say, so a move cannot disagree with itself, and
# `Position.play` checks it is legal where it is played.

import square {Square.*}
import role {Role.*, promotions, role_letter, role_of_letter}

export {Move.*}

Move : {from: Square, to: Square, promotion: Result(Role, [NoPromotion])}.(
  # The move from `from` to `to`, nothing promoted. A castle is the king's
  # move of two squares, `e1` to `g1`.
  of_squares : (Square, Square) -> Move
  of_squares(from, to) -> Move({from, to, promotion: Err(NoPromotion)})
  expect Move.from_uci("g1f3") == Square.from_str("g1").and_then(|from| Square.from_str("f3").map_ok(|to| Move.of_squares(from, to)))

  # A pawn's move from `from` to `to`, on the last rank, becoming `role`.
  of_promotion : (Square, Square, Role) -> Move
  of_promotion(from, to, role) -> Move({from, to, promotion: Ok(role)})
  expect Move.from_uci("e7e8q") == Square.from_str("e7").and_then(|from| Square.from_str("e8").map_ok(|to| Move.of_promotion(from, to, Queen)))

  # The square the piece moves from: for a castle, the king's.
  from : Move -> Square
  from(Move({from, *})) -> from
  expect Move.from_uci("g1f3").map_ok(|move| move.from().to_str()) == Ok("g1")

  # The square the piece lands on: for a castle, the king's.
  to : Move -> Square
  to(Move({to, *})) -> to
  expect Move.from_uci("g1f3").map_ok(|move| move.to().to_str()) == Ok("f3")

  # The role a pawn becomes on the last rank, if it does.
  promotion : Move -> Result(Role, [NoPromotion])
  promotion(Move({promotion, *})) -> promotion
  expect Move.from_uci("e7e8n").map_ok(Move.promotion) == Ok(Ok(Knight))
  expect Move.from_uci("e2e4").map_ok(Move.promotion) == Ok(Err(NoPromotion))

  # The move UCI's `text` writes: the squares it goes from and to, and the
  # small letter of a role a pawn may become, as `e2e4` or `e7e8q`.
  # Whether it is legal is asked where it is played.
  from_uci : Str -> Result(Move, [Malformed])
  from_uci(text) -> text.to_utf8() is (
    [a, b, c, d] then Ok(of_squares(square(a, b)?, square(c, d)?))
    [a, b, c, d, letter] then (
      role = role_of_letter(letter)?
      if !promotions.contains(role) | letter.is_ascii_upper() return Err(Malformed)
      Ok(of_promotion(square(a, b)?, square(c, d)?, role))
    )
    _ then Err(Malformed)
  )
  expect Move.from_uci("e2e4").map_ok(Move.to_uci) == Ok("e2e4")
  expect Move.from_uci("e7e8k") == Err(Malformed)
  expect Move.from_uci("e7e8Q") == Err(Malformed)
  expect Move.from_uci("e2") == Err(Malformed)
  expect Move.from_uci("e2e9") == Err(Malformed)

  # The move as UCI writes it: the squares it goes from and to, and the
  # small letter of the role a pawn becomes.
  to_uci : Move -> Str
  to_uci(Move(move)) -> (
    promoted = move.promotion is (
      Ok(role) then Str.from_ascii([role_letter(role)]).ok_or("")
      Err(NoPromotion) then ""
    )
    "${move.from}${move.to}${promoted}"
  )
  expect Move.from_uci("e7e8q").map_ok(Move.to_uci) == Ok("e7e8q")

  # The move as UCI writes it, as `to_uci` does.
  to_str : Move -> Str
  to_str(move) -> move.to_uci()
  expect Move.from_uci("e1g1").map_ok(|move| "${move}") == Ok("e1g1")

  equals : (Move, Move) -> Bool
)

# The square a file's letter and a rank's digit name.
square : (U8, U8) -> Result(Square, [Malformed])
square(letter, digit) -> Square.from_str(Str.from_ascii([letter, digit]).err_as(Malformed)?)
