# The eight ways a piece steps from one square to the next, and the step
# itself.

import square {Square.*}

export {Direction.*, step}

# One of the eight ways a king steps, as White sees the board: `North`
# toward the eighth rank, `East` toward the `h` file.
Direction : [North, NorthEast, East, SouthEast, South, SouthWest, West, NorthWest].(
  # The four along a file or a rank, the ways a rook moves.
  straight : List(Direction)
  straight = [North, East, South, West]
  expect Direction.straight.len() == 4

  # The four along a diagonal, the ways a bishop moves.
  diagonal : List(Direction)
  diagonal = [NorthEast, SouthEast, SouthWest, NorthWest]
  expect Direction.diagonal.len() == 4

  # All eight, the ways a king and a queen move.
  all : List(Direction)
  all = straight.concat(diagonal)
  expect Direction.all.len() == 8

  # The way pointing back.
  opposite : Direction -> Direction
  opposite(North) -> South
  opposite(NorthEast) -> SouthWest
  opposite(East) -> West
  opposite(SouthEast) -> NorthWest
  opposite(South) -> North
  opposite(SouthWest) -> NorthEast
  opposite(West) -> East
  opposite(NorthWest) -> SouthEast
  expect Direction.all.all(|way| way.opposite().opposite() == way)

  equals : (Direction, Direction) -> Bool
  to_str : Direction -> Str
)

# The square one step from `square` the way `direction` points, or
# `OffBoard` where that leaves the board.
step : (Square, Direction) -> Result(Square, [OffBoard])
step(Square(n), North) if n < 56 -> Ok(Square(n + 8))
step(Square(n), South) if n >= 8 -> Ok(Square(n - 8))
step(Square(n), East) if n % 8 < 7 -> Ok(Square(n + 1))
step(Square(n), West) if n % 8 > 0 -> Ok(Square(n - 1))
step(Square(n), NorthEast) if n < 56 & n % 8 < 7 -> Ok(Square(n + 9))
step(Square(n), NorthWest) if n < 56 & n % 8 > 0 -> Ok(Square(n + 7))
step(Square(n), SouthEast) if n >= 8 & n % 8 < 7 -> Ok(Square(n - 7))
step(Square(n), SouthWest) if n >= 8 & n % 8 > 0 -> Ok(Square(n - 9))
step(_, _) -> Err(OffBoard)
expect step(Square(28), NorthEast).map_ok(Square.to_str) == Ok("f5")
expect step(Square(31), East) == Err(OffBoard)
