# Checksums over bytes: CRC-32 and Adler-32, each whole or folded in
# pieces.
#
# CRC-32 is the one zlib, gzip, PNG, ZIP and Ethernet compute: ISO-HDLC,
# reflected, polynomial 0xEDB88320, the register started and finished
# inverted. Adler-32 is the one zlib's container ends with: the sum of the
# bytes plus one, and the sum of those sums, each modulo 65521. CRC-32
# catches more errors, every burst of up to 32 bits among them; Adler-32 is
# cheaper and weak on short messages. Neither is a cryptographic hash: each
# catches accidents, not tampering.
#
# Written in the most natural Faun spelling: where that runs slowly, the
# compiler has a bug to fix, and notes/compression.md lists them.

package {}

export {Crc32, Adler32, crc32, adler32}

# The CRC-32 of `bytes`. `Crc32` folds one in pieces.
crc32 : List(U8) -> U32
crc32(bytes) -> Crc32.empty.update(bytes).value()
expect crc32("123456789".to_utf8()) == 0xcbf43926
expect crc32([]) == 0

# The Adler-32 of `bytes`. `Adler32` folds one in pieces.
adler32 : List(U8) -> U32
adler32(bytes) -> Adler32.empty.update(bytes).value()
expect adler32("Wikipedia".to_utf8()) == 0x11e60398
expect adler32([]) == 1

# A CRC-32 part way through a message: the register, held inverted as the
# algorithm runs it, so `update` neither starts nor ends with a flip.
Crc32 : U32.(
  # The CRC-32 of no bytes yet.
  empty : Crc32
  empty = Crc32(0xffffffff)
  expect Crc32.empty.value() == 0

  # Where a message's CRC-32, `value`, leaves off, so the bytes after it
  # can be folded in: the checksum of a file grown since it was taken.
  resume : U32 -> Crc32
  resume(value) -> Crc32(!value)
  expect Crc32.resume(crc32("1234".to_utf8())).update("56789".to_utf8()).value() == 0xcbf43926

  # `crc` with `bytes` folded in after what it has seen.
  update : (Crc32, List(U8)) -> Crc32
  update(Crc32(register), bytes) -> Crc32(crc_bytes(register, bytes))
  expect Crc32.empty.update("1234".to_utf8()).update("56789".to_utf8()).value() == 0xcbf43926

  # The CRC-32 of every byte folded in. `crc` is left as it was, so more
  # may be folded in after.
  value : Crc32 -> U32
  value(Crc32(register)) -> !register
  expect Crc32.empty.update("123456789".to_utf8()).value() == 0xcbf43926
)

# An Adler-32 part way through a message: the sum of its bytes plus one,
# and the sum of those sums, each modulo 65521.
Adler32 : (U64, U64).(
  # The Adler-32 of no bytes yet.
  empty : Adler32
  empty = Adler32((1, 0))
  expect Adler32.empty.value() == 1

  # Where a message's Adler-32, `value`, leaves off, so the bytes after it
  # can be folded in. A value no Adler-32 has, a sum of 65521 or more,
  # resumes from its sums reduced.
  resume : U32 -> Adler32
  resume(value) -> (
    whole = value.to_nat()
    Adler32((U64.of_nat(whole % 65536 % 65521), U64.of_nat(whole / 65536 % 65521)))
  )
  expect Adler32.resume(adler32("Wiki".to_utf8())).update("pedia".to_utf8()).value() == 0x11e60398

  # `adler` with `bytes` folded in after what it has seen.
  update : (Adler32, List(U8)) -> Adler32
  update(Adler32((low, high)), bytes) -> Adler32(adler_bytes(low, high, adler_run, bytes))
  expect Adler32.empty.update("Wiki".to_utf8()).update("pedia".to_utf8()).value() == 0x11e60398

  # The Adler-32 of every byte folded in. `adler` is left as it was, so
  # more may be folded in after.
  value : Adler32 -> U32
  value(Adler32((low, high))) -> U32.of_nat(high.to_nat() * 65536 + low.to_nat())
  expect Adler32.empty.update("Wikipedia".to_utf8()).value() == 0x11e60398
)

# Eight bytes a step, slicing-by-8 as zlib and crc32fast read them: the
# register mixed with the first four, and eight table lookups, one a
# byte, each table the register after its byte and as many noughts as the
# table's place. The bytes left over go one at a time. The eight tables are
# the algorithm, not an unrolling: no compiler derives them from the
# byte-at-a-time one.
crc_bytes : (U32, List(U8)) -> U32
crc_bytes(register, [a, b, c, d, e, f, g, h, *rest]) -> (
  one = register ^ U32.of_le_bytes(a, b, c, d)
  crc_bytes(
    lookup(7, one) ^ lookup(6, one >> 8) ^ lookup(5, one >> 16) ^ lookup(4, one >> 24)
      ^ lookup(3, U32.of_u8(e)) ^ lookup(2, U32.of_u8(f)) ^ lookup(1, U32.of_u8(g)) ^ lookup(0, U32.of_u8(h)),
    rest)
)
crc_bytes(register, bytes) -> crc_tail(register, bytes)

crc_tail : (U32, List(U8)) -> U32
crc_tail(register, []) -> register
crc_tail(register, [byte, *rest]) ->
  crc_tail(lookup(0, register ^ U32.of_u8(byte)) ^ (register >> 8), rest)

# The entry of table `slice` for the low byte of `index`.
lookup : (Nat, U32) -> U32
lookup(slice, index) -> crc_table.get(slice * 256 + (index.to_nat() & 0xff)).ok_or(0)

# Eight tables of 256, one after another: the first the register after
# each byte alone, from nought, and each after it the one before it with
# a nought byte more.
crc_table : List(U32)
crc_table = (
  first = List.range(256).map(|n| crc_entry(U32.of_nat(n), 8))
  crc_slices(first, first, 7)
)

crc_slices : (List(U32), List(U32), Nat) -> List(U32)
crc_slices(_, tables, 0) -> tables
crc_slices(first, tables, Succ(left)) -> (
  last = tables.drop(tables.len() - 256)
  next = last.map(|entry| first.get(entry.to_nat() & 0xff).ok_or(0) ^ (entry >> 8))
  crc_slices(first, tables.concat(next), left)
)

crc_entry : (U32, Nat) -> U32
crc_entry(register, 0) -> register
crc_entry(register, Succ(bits)) if (register & 1) == 1 ->
  crc_entry(0xedb88320 ^ (register >> 1), bits)
crc_entry(register, Succ(bits)) -> crc_entry(register >> 1, bits)

# How many bytes the sums take before they are reduced. zlib reduces its
# 32-bit sums every 5552 bytes; in 64 bits, from below the modulus, the
# larger sum is below 2^64 after 2^22 bytes by a margin of thousands.
adler_run : Nat
adler_run = 4194304

# A byte at a time, the sums reduced every `adler_run` bytes and at the end.
adler_bytes : (U64, U64, Nat, List(U8)) -> (U64, U64)
adler_bytes(low, high, _, []) -> (low % 65521, high % 65521)
adler_bytes(low, high, 0, bytes) -> adler_bytes(low % 65521, high % 65521, adler_run, bytes)
adler_bytes(low, high, Succ(left), [byte, *rest]) -> (
  sum = low + U64.of_u8(byte)
  adler_bytes(sum, high + sum, left, rest)
)

expect crc32("The quick brown fox jumps over the lazy dog".to_utf8()) == 0x414fa339

# A run of 0xff, the worst case for the sums, past several reductions.
expect adler32(List.repeat(255, 20000)) == 0x9f51d664

# Split updates, or a checksum resumed, give the whole message's
# checksum, wherever they split.
expect (
  message = List.range(300).map(U8.of_nat)
  [0, 1, 7, 8, 9, 255, 299, 300].all(|n|
    Crc32.empty.update(message.take(n)).update(message.drop(n)).value() == crc32(message)
      & Adler32.empty.update(message.take(n)).update(message.drop(n)).value() == adler32(message)
      & Crc32.resume(crc32(message.take(n))).update(message.drop(n)).value() == crc32(message)
      & Adler32.resume(adler32(message.take(n))).update(message.drop(n)).value() == adler32(message))
)

# A value no Adler-32 has resumes from its sums reduced: 65521 is 0.
expect Adler32.resume(65521 * 65536 + 65522).value() == 1
