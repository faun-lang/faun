# 64-bit words: the ring of naturals modulo 18446744073709551616, wrapping by definition
# rather than overflowing. The wrapper is private, so every `U64` is below
# its modulus; a numeral builds one through `of_nat`, and one written at or
# above `numerals_below` is refused rather than wrapped.

import hasher {Hasher}

export {U64}

numerals_below : Nat
numerals_below = 18446744073709551616

U64 : Nat.(
  zero : U64
  zero = U64(0)
  expect U64.zero == 0

  # Compatibility spelling for explicit Nat calls; also the compiler's
  # numeral constructor. Use `wrap` to request modular narrowing.
  of_nat : Nat -> U64
  of_nat(n) -> U64(n % 18446744073709551616)
  expect U64.of_nat(18446744073709551617) == 1

  # The low 64 bits of the source's natural value, with no fit check.
  wrap : a -> U64 where a.to_nat : a -> Nat
  wrap(value) -> of_nat(value.to_nat())
  expect U64.wrap(18446744073709551616) == 0

  to_nat : U64 -> Nat
  to_nat(U64(value)) -> value
  expect U64.of_nat(70000).to_nat() == 70000

  add : (U64, U64) -> U64
  add(U64(a), U64(b)) -> U64((a + b) % 18446744073709551616)
  expect U64.of_nat(0xffffffffffffffff) + 1 == 0

  sub : (U64, U64) -> U64
  sub(U64(a), U64(b)) -> U64((a + 18446744073709551616 - b) % 18446744073709551616)
  expect U64.of_nat(0) - 1 == 0xffffffffffffffff

  mul : (U64, U64) -> U64
  mul(U64(a), U64(b)) -> U64((a * b) % 18446744073709551616)
  expect U64.of_nat(0x100000000) * 0x100000000 == 0

  div : (U64, U64) -> U64
  div(U64(a), U64(b)) -> U64(a / b)
  expect U64.of_nat(7) / 2 == 3

  mod : (U64, U64) -> U64
  mod(U64(a), U64(b)) -> U64(a % b)
  expect U64.of_nat(7) % 2 == 1

  cmp : (U64, U64) -> Order

  to_str : U64 -> Str

  # Bitwise, as `Nat`'s: `a & b`, `a | b` and `a ^ b`. Two words' bits
  # make a word, so the remainder changes nothing and costs nothing; it
  # says the answer is one even where a word's range is still being
  # worked out round a loop.
  and : (U64, U64) -> U64
  and(U64(a), U64(b)) -> U64((a & b) % 18446744073709551616)
  expect (U64.of_nat(12) & 10) == 8

  or : (U64, U64) -> U64
  or(U64(a), U64(b)) -> U64((a | b) % 18446744073709551616)
  expect (U64.of_nat(0xf0) | 0x0f) == 0xff

  xor : (U64, U64) -> U64
  xor(U64(a), U64(b)) -> U64((a ^ b) % 18446744073709551616)
  expect (U64.of_nat(12) ^ 10) == 6

  # Every bit flipped.
  not : U64 -> U64
  not(U64(a)) -> U64(18446744073709551615 - a)
  expect !U64.of_nat(0) == 0xffffffffffffffff

  # The bits moved up by `amount`, those past the top lost: nought where
  # `amount` is the width or more.
  shift_left : (U64, Nat) -> U64
  shift_left(U64(a), amount) if amount < 64 -> of_nat(a * 2.pow(amount))
  shift_left(_, _) -> U64(0)
  expect U64.of_nat(0x8000000000000001).shift_left(1) == 2
  expect U64.of_nat(1).shift_left(64) == 0

  # The bits moved down by `amount`, those below the bottom lost.
  shift_right : (U64, Nat) -> U64
  shift_right(U64(a), amount) if amount < 64 -> U64(a / 2.pow(amount))
  shift_right(_, _) -> U64(0)
  expect U64.of_nat(0x8000000000000001).shift_right(63) == 1

  # The bits moved up by `amount`, those past the top coming round to the
  # bottom. The width round is no change.
  rotate_left : (U64, Nat) -> U64
  rotate_left(U64(a), amount) -> (
    shift = amount % 64
    of_nat(a * 2.pow(shift) + a / 2.pow(64 - shift))
  )
  expect U64.of_nat(0x8000000000000001).rotate_left(1) == 3

  rotate_right : (U64, Nat) -> U64
  rotate_right(word, amount) -> rotate_left(word, 64 - amount % 64)
  expect U64.of_nat(0x8000000000000001).rotate_right(1) == 0xc000000000000000

  # How many of the word's bits are set, counted in place a pair, then a
  # nibble, then a byte at a time, and the bytes summed by one
  # multiplication: Hacker's Delight's count, with no loop.
  count_ones : U64 -> Nat
  count_ones(word) -> (
    pairs = word - (word.shift_right(1) & 0x5555555555555555)
    nibbles = (pairs & 0x3333333333333333) + (pairs.shift_right(2) & 0x3333333333333333)
    bytes = (nibbles + nibbles.shift_right(4)) & 0x0f0f0f0f0f0f0f0f
    (bytes * 0x0101010101010101).shift_right(56).to_nat()
  )
  expect U64.of_nat(0).count_ones() == 0
  expect U64.of_nat(0x8000000000000000).count_ones() == 1
  expect U64.of_nat(0xffffffffffffffff).count_ones() == 64
  expect U64.of_nat(0x0000000580000000).count_ones() == 3

  # How many bits are clear below the lowest set one, which is its index.
  # Nought has none set, so all 64 are clear: the width. Taking one borrows
  # from the lowest set bit, setting every bit below it, and those are the
  # ones `word` has clear.
  trailing_zeros : U64 -> Nat
  trailing_zeros(word) -> count_ones(!word & (word - 1))
  expect U64.of_nat(0).trailing_zeros() == 64
  expect U64.of_nat(1).trailing_zeros() == 0
  expect U64.of_nat(0x8000000000000000).trailing_zeros() == 63
  expect U64.of_nat(0xffffffffffffffff).trailing_zeros() == 0
  expect U64.of_nat(0x0000000580000000).trailing_zeros() == 31

  # How many bits are clear above the highest set one. Nought has none set,
  # so all 64 are clear: the width. The highest set bit is copied into
  # every place below it, and the ones then counted.
  leading_zeros : U64 -> Nat
  leading_zeros(word) -> (
    pairs = word | word.shift_right(1)
    nibbles = pairs | pairs.shift_right(2)
    bytes = nibbles | nibbles.shift_right(4)
    shorts = bytes | bytes.shift_right(8)
    halves = shorts | shorts.shift_right(16)
    64 - count_ones(halves | halves.shift_right(32))
  )
  expect U64.of_nat(0).leading_zeros() == 64
  expect U64.of_nat(1).leading_zeros() == 63
  expect U64.of_nat(0x8000000000000000).leading_zeros() == 0
  expect U64.of_nat(0xffffffffffffffff).leading_zeros() == 0
  expect U64.of_nat(0x0000000580000000).leading_zeros() == 29

  # How many of the word's bits are clear: the ones of its complement.
  count_zeros : U64 -> Nat
  count_zeros(word) -> count_ones(!word)
  expect U64.of_nat(0).count_zeros() == 64
  expect U64.of_nat(0x8000000000000000).count_zeros() == 63
  expect U64.of_nat(0xffffffffffffffff).count_zeros() == 0
  expect U64.of_nat(0x0000000580000000).count_zeros() == 61

  # How many bits are set above the highest clear one: the leading zeros
  # of its complement, so the width for a word of all ones.
  leading_ones : U64 -> Nat
  leading_ones(word) -> leading_zeros(!word)
  expect U64.of_nat(0).leading_ones() == 0
  expect U64.of_nat(0x8000000000000000).leading_ones() == 1
  expect U64.of_nat(0xffffffffffffffff).leading_ones() == 64
  expect U64.of_nat(0xfffffffffffffff8).leading_ones() == 61

  # How many bits are set below the lowest clear one: the trailing zeros
  # of its complement, so the width for a word of all ones.
  trailing_ones : U64 -> Nat
  trailing_ones(word) -> trailing_zeros(!word)
  expect U64.of_nat(0).trailing_ones() == 0
  expect U64.of_nat(1).trailing_ones() == 1
  expect U64.of_nat(0xffffffffffffffff).trailing_ones() == 64
  expect U64.of_nat(0x1fffffffffffffff).trailing_ones() == 61

  # `n` as a word when it fits, and a refusal when it does not: the
  # checked narrowing, for values worked out at run time.
  from_nat : Nat -> Result(U64, [TooBig])
  from_nat(n) if n < 0x10000000000000000 -> Ok(of_nat(n))
  from_nat(_) -> Err(TooBig)
  expect U64.from_nat(18446744073709551615) == Ok(0xffffffffffffffff)
  expect U64.from_nat(18446744073709551616) == Err(TooBig)

  # `base` raised to the `exponent`-th power, modulo 0x10000000000000000, by
  # `Nat.pow_mod`, so no intermediate grows past the ring.
  pow : (U64, Nat) -> U64
  pow(U64(base), exponent) -> U64(base.pow_mod(exponent, 0x10000000000000000))
  expect U64.of_nat(3).pow(4) == 81
  expect U64.of_nat(2).pow(64) == 0

  # The smaller of `a` and `b`.
  min : (U64, U64) -> U64
  min(U64(a), U64(b)) -> U64(a.min(b))
  expect U64.of_nat(7).min(3) == 3

  # The larger of `a` and `b`.
  max : (U64, U64) -> U64
  max(U64(a), U64(b)) -> U64(a.max(b))
  expect U64.of_nat(7).max(9) == 9

  # `word` as a `U64`; widening cannot wrap.
  of_u8 : U8 -> U64
  of_u8(word) -> U64(U8.to_nat(word))
  expect U64.of_u8(200) == 200

  # `word` as a `U64`; widening cannot wrap.
  of_u16 : U16 -> U64
  of_u16(word) -> U64(U16.to_nat(word))
  expect U64.of_u16(60000) == 60000

  # `word` as a `U64`; widening cannot wrap.
  of_u32 : U32 -> U64
  of_u32(word) -> U64(U32.to_nat(word))
  expect U64.of_u32(5) == 5

  # The word's 8 bytes, least significant first. The count is the
  # contract, so the shape says it, and taking the tuple apart always matches.
  le_bytes : U64 -> (U8, U8, U8, U8, U8, U8, U8, U8)
  le_bytes(word) -> (
    U8.wrap(word),
    U8.wrap(shift_right(word, 8)),
    U8.wrap(shift_right(word, 16)),
    U8.wrap(shift_right(word, 24)),
    U8.wrap(shift_right(word, 32)),
    U8.wrap(shift_right(word, 40)),
    U8.wrap(shift_right(word, 48)),
    U8.wrap(shift_right(word, 56)),
  )
  expect U64.of_nat(0x0807060504030201).le_bytes() == (1, 2, 3, 4, 5, 6, 7, 8)

  # The word whose little-endian bytes are these, least significant first.
  # The arity makes the width static, so every input converts.
  of_le_bytes : (U8, U8, U8, U8, U8, U8, U8, U8) -> U64
  of_le_bytes(a, b, c, d, e, f, g, h) ->
    of_u8(a) |
    shift_left(of_u8(b), 8) |
    shift_left(of_u8(c), 16) |
    shift_left(of_u8(d), 24) |
    shift_left(of_u8(e), 32) |
    shift_left(of_u8(f), 40) |
    shift_left(of_u8(g), 48) |
    shift_left(of_u8(h), 56)
  expect U64.of_le_bytes(1, 0, 0, 0, 0, 0, 0, 0x80) == 0x8000000000000001

  # The word's low 32 bits. Prefer `U32.wrap(word)` in new code.
  to_u32 : U64 -> U32
  to_u32(word) -> U32.wrap(word)
  expect U64.of_nat(0x1122334455667788).to_u32() == 0x55667788

  # The word's low 8 bits. Prefer `U8.wrap(word)` in new code.
  to_u8 : U64 -> U8
  to_u8(word) -> U8.wrap(word)
  expect U64.of_nat(0x1ff).to_u8() == 0xff

  # `hasher` with `a` fed: itself.
  hash_into : (U64, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(a)
)
