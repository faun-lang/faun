# 16-bit words: the ring of naturals modulo 65536, wrapping by definition
# rather than overflowing. The wrapper is private, so every `U16` is below
# its modulus; a numeral builds one through `of_nat`, and one written at or
# above `numerals_below` is refused rather than wrapped.

import hasher {Hasher}

export {U16}

numerals_below : Nat
numerals_below = 65536

U16 : Nat.(
  zero : U16
  zero = U16(0)
  expect U16.zero == 0

  # Compatibility spelling for explicit Nat calls; also the compiler's
  # numeral constructor. Use `wrap` to request modular narrowing.
  of_nat : Nat -> U16
  of_nat(n) -> U16(n % 65536)
  expect U16.of_nat(70000) == 4464

  # The low 16 bits of the source's natural value, with no fit check.
  wrap : a -> U16 where a.to_nat : a -> Nat
  wrap(value) -> of_nat(value.to_nat())
  expect U16.wrap(65536) == 0

  to_nat : U16 -> Nat
  to_nat(U16(value)) -> value
  expect U16.of_nat(1000).to_nat() == 1000

  add : (U16, U16) -> U16
  add(U16(a), U16(b)) -> U16((a + b) % 65536)
  expect U16.of_nat(65535) + 1 == 0

  sub : (U16, U16) -> U16
  sub(U16(a), U16(b)) -> U16((a + 65536 - b) % 65536)
  expect U16.of_nat(0) - 1 == 65535

  mul : (U16, U16) -> U16
  mul(U16(a), U16(b)) -> U16((a * b) % 65536)
  expect U16.of_nat(256) * 256 == 0

  div : (U16, U16) -> U16
  div(U16(a), U16(b)) -> U16(a / b)
  expect U16.of_nat(7) / 2 == 3

  mod : (U16, U16) -> U16
  mod(U16(a), U16(b)) -> U16(a % b)
  expect U16.of_nat(7) % 2 == 1

  cmp : (U16, U16) -> Order

  to_str : U16 -> Str

  # Bitwise, as `Nat`'s: `a & b`, `a | b` and `a ^ b`. Two words' bits
  # make a word, so the remainder changes nothing and costs nothing; it
  # says the answer is one even where a word's range is still being
  # worked out round a loop.
  and : (U16, U16) -> U16
  and(U16(a), U16(b)) -> U16((a & b) % 65536)
  expect (U16.of_nat(0xff00) & 0x0ff0) == 0x0f00

  or : (U16, U16) -> U16
  or(U16(a), U16(b)) -> U16((a | b) % 65536)
  expect (U16.of_nat(0xff00) | 0x00ff) == 0xffff

  xor : (U16, U16) -> U16
  xor(U16(a), U16(b)) -> U16((a ^ b) % 65536)
  expect (U16.of_nat(0xff00) ^ 0x0ff0) == 0xf0f0

  # Every bit flipped.
  not : U16 -> U16
  not(U16(a)) -> U16(65535 - a)
  expect !U16.of_nat(0) == 0xffff

  # The bits moved up by `amount`, those past the top lost: nought where
  # `amount` is the width or more.
  shift_left : (U16, Nat) -> U16
  shift_left(U16(a), amount) if amount < 16 -> of_nat(a * 2.pow(amount))
  shift_left(_, _) -> U16(0)
  expect U16.of_nat(0x8001).shift_left(1) == 2
  expect U16.of_nat(1).shift_left(16) == 0

  # The bits moved down by `amount`, those below the bottom lost.
  shift_right : (U16, Nat) -> U16
  shift_right(U16(a), amount) if amount < 16 -> U16(a / 2.pow(amount))
  shift_right(_, _) -> U16(0)
  expect U16.of_nat(0x8001).shift_right(15) == 1

  # The bits moved up by `amount`, those past the top coming round to the
  # bottom. The width round is no change.
  rotate_left : (U16, Nat) -> U16
  rotate_left(U16(a), amount) -> (
    # The bits moved up, below the width, and those past it, above.
    moved = a * 2.pow(amount % 16)
    U16(moved % 65536 + moved / 65536)
  )
  expect U16.of_nat(0x8001).rotate_left(1) == 3

  rotate_right : (U16, Nat) -> U16
  rotate_right(word, amount) -> rotate_left(word, 16 - amount % 16)
  expect U16.of_nat(0x8001).rotate_right(1) == 0xc000

  # How many of the word's bits are set, counted in place a pair, then a
  # nibble, then a byte at a time, and the bytes summed by one
  # multiplication: Hacker's Delight's count, with no loop.
  count_ones : U16 -> Nat
  count_ones(word) -> (
    pairs = word - (word.shift_right(1) & 0x5555)
    nibbles = (pairs & 0x3333) + (pairs.shift_right(2) & 0x3333)
    bytes = (nibbles + nibbles.shift_right(4)) & 0x0f0f
    (bytes * 0x0101).shift_right(8).to_nat()
  )
  expect U16.of_nat(0).count_ones() == 0
  expect U16.of_nat(0x8000).count_ones() == 1
  expect U16.of_nat(0xffff).count_ones() == 16
  expect U16.of_nat(0x0580).count_ones() == 3

  # How many bits are clear below the lowest set one, which is its index.
  # Nought has none set, so all 16 are clear: the width. Taking one borrows
  # from the lowest set bit, setting every bit below it, and those are the
  # ones `word` has clear.
  trailing_zeros : U16 -> Nat
  trailing_zeros(word) -> count_ones(!word & (word - 1))
  expect U16.of_nat(0).trailing_zeros() == 16
  expect U16.of_nat(1).trailing_zeros() == 0
  expect U16.of_nat(0x8000).trailing_zeros() == 15
  expect U16.of_nat(0xffff).trailing_zeros() == 0
  expect U16.of_nat(0x0580).trailing_zeros() == 7

  # How many bits are clear above the highest set one. Nought has none set,
  # so all 16 are clear: the width. The highest set bit is copied into
  # every place below it, and the ones then counted.
  leading_zeros : U16 -> Nat
  leading_zeros(word) -> (
    pairs = word | word.shift_right(1)
    nibbles = pairs | pairs.shift_right(2)
    bytes = nibbles | nibbles.shift_right(4)
    16 - count_ones(bytes | bytes.shift_right(8))
  )
  expect U16.of_nat(0).leading_zeros() == 16
  expect U16.of_nat(1).leading_zeros() == 15
  expect U16.of_nat(0x8000).leading_zeros() == 0
  expect U16.of_nat(0xffff).leading_zeros() == 0
  expect U16.of_nat(0x0580).leading_zeros() == 5

  # `n` as a word when it fits, and a refusal when it does not: the
  # checked narrowing, for values worked out at run time.
  from_nat : Nat -> Result(U16, [TooBig])
  from_nat(n) if n < 0x10000 -> Ok(of_nat(n))
  from_nat(_) -> Err(TooBig)
  expect U16.from_nat(65535) == Ok(65535)
  expect U16.from_nat(65536) == Err(TooBig)

  # `base` raised to the `exponent`-th power, modulo 0x10000, by
  # `Nat.pow_mod`, so no intermediate grows past the ring.
  pow : (U16, Nat) -> U16
  pow(U16(base), exponent) -> U16(base.pow_mod(exponent, 0x10000))
  expect U16.of_nat(3).pow(4) == 81
  expect U16.of_nat(2).pow(16) == 0

  # The smaller of `a` and `b`.
  min : (U16, U16) -> U16
  min(U16(a), U16(b)) -> U16(a.min(b))
  expect U16.of_nat(7).min(3) == 3

  # The larger of `a` and `b`.
  max : (U16, U16) -> U16
  max(U16(a), U16(b)) -> U16(a.max(b))
  expect U16.of_nat(7).max(9) == 9

  # `word` as a `U16`; widening cannot wrap.
  of_u8 : U8 -> U16
  of_u8(word) -> U16(U8.to_nat(word))
  expect U16.of_u8(200) == 200

  # The word's 2 bytes, least significant first. The count is the
  # contract, so the shape says it, and taking the tuple apart always matches.
  le_bytes : U16 -> (U8, U8)
  le_bytes(word) -> (
    U8.wrap(word),
    U8.wrap(shift_right(word, 8)),
  )
  expect U16.of_nat(0xabcd).le_bytes() == (0xcd, 0xab)

  # The word whose little-endian bytes are these, least significant first.
  # The arity makes the width static, so every input converts.
  of_le_bytes : (U8, U8) -> U16
  of_le_bytes(a, b) ->
    of_u8(a) |
    shift_left(of_u8(b), 8)
  expect U16.of_le_bytes(0xcd, 0xab) == 0xabcd

  # `hasher` with `a` fed: widened to a word.
  hash_into : (U16, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(U64.of_nat(to_nat(a)))
)
