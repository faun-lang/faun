# 8-bit words: the ring of naturals modulo 256, wrapping by definition
# rather than overflowing. The wrapper is private, so every `U8` is below
# its modulus; a numeral builds one through `of_nat`, and one written at or
# above `numerals_below` is refused rather than wrapped. String syntax, and
# nothing else outside, may build the wrapper directly.

import hasher {Hasher}

export {U8}

numerals_below : Nat
numerals_below = 256

U8 : Nat.(
  zero : U8
  zero = U8(0)
  expect U8.zero == 0

  of_nat : Nat -> U8
  of_nat(n) -> U8(n % 256)
  expect U8.of_nat(300) == 44

  to_nat : U8 -> Nat
  to_nat(U8(value)) -> value
  expect U8.of_nat(200).to_nat() == 200

  add : (U8, U8) -> U8
  add(U8(a), U8(b)) -> U8((a + b) % 256)
  expect U8.of_nat(250) + 10 == 4

  sub : (U8, U8) -> U8
  sub(U8(a), U8(b)) -> U8((a + 256 - b) % 256)
  expect U8.of_nat(3) - 5 == 254

  mul : (U8, U8) -> U8
  mul(U8(a), U8(b)) -> U8((a * b) % 256)
  expect U8.of_nat(16) * 17 == 16

  div : (U8, U8) -> U8
  div(U8(a), U8(b)) -> U8(a / b)
  expect U8.of_nat(7) / 2 == 3

  mod : (U8, U8) -> U8
  mod(U8(a), U8(b)) -> U8(a % b)
  expect U8.of_nat(7) % 2 == 1

  cmp : (U8, U8) -> Order

  min : (U8, U8) -> U8
  min(a, b) -> (a <= b).select(a, b)
  expect U8.of_nat(3).min(5) == 3

  max : (U8, U8) -> U8
  max(a, b) -> (a <= b).select(b, a)
  expect U8.of_nat(3).max(5) == 5

  to_str : U8 -> Str

  # Whether the byte is an ASCII digit, `'0'` to `'9'`.
  is_digit : U8 -> Bool
  is_digit(U8('0'..'9')) -> True
  is_digit(_) -> False
  expect '7'.is_digit()
  expect !'x'.is_digit()

  is_ascii_lower : U8 -> Bool
  is_ascii_lower(U8('a'..'z')) -> True
  is_ascii_lower(_) -> False
  expect 'q'.is_ascii_lower() & !'Q'.is_ascii_lower()

  is_ascii_upper : U8 -> Bool
  is_ascii_upper(U8('A'..'Z')) -> True
  is_ascii_upper(_) -> False
  expect 'Q'.is_ascii_upper() & !'q'.is_ascii_upper()

  is_ascii_letter : U8 -> Bool
  is_ascii_letter(byte) -> byte.is_ascii_lower() | byte.is_ascii_upper()
  expect 'a'.is_ascii_letter() & 'Z'.is_ascii_letter()
  expect !'1'.is_ascii_letter()

  # An ASCII capital as its small letter, and any other byte as it is.
  to_ascii_lower : U8 -> U8
  to_ascii_lower(byte) if byte.is_ascii_upper() -> byte + 32
  to_ascii_lower(byte) -> byte
  expect 'Q'.to_ascii_lower() == 'q'
  expect '1'.to_ascii_lower() == '1'

  # An ASCII small letter as its capital, and any other byte as it is.
  to_ascii_upper : U8 -> U8
  to_ascii_upper(byte) if byte.is_ascii_lower() -> byte - 32
  to_ascii_upper(byte) -> byte
  expect 'q'.to_ascii_upper() == 'Q'
  expect '1'.to_ascii_upper() == '1'

  # Bitwise, as `Nat`'s: `a & b`, `a | b` and `a ^ b`. Two words' bits
  # make a word, so the remainder changes nothing and costs nothing; it
  # says the answer is one even where a word's range is still being
  # worked out round a loop.
  and : (U8, U8) -> U8
  and(U8(a), U8(b)) -> U8((a & b) % 256)
  expect (U8.of_nat(12) & 10) == 8

  or : (U8, U8) -> U8
  or(U8(a), U8(b)) -> U8((a | b) % 256)
  expect (U8.of_nat(0xf0) | 0x0f) == 255

  xor : (U8, U8) -> U8
  xor(U8(a), U8(b)) -> U8((a ^ b) % 256)
  expect (U8.of_nat(12) ^ 10) == 6

  # Every bit flipped.
  not : U8 -> U8
  not(U8(a)) -> U8(255 - a)
  expect !U8.of_nat(0b10100101) == 0b01011010

  # The bits moved up by `amount`, those past the top lost: nought where
  # `amount` is the width or more.
  shift_left : (U8, Nat) -> U8
  shift_left(U8(a), amount) if amount < 8 -> of_nat(a * 2.pow(amount))
  shift_left(_, _) -> U8(0)
  expect U8.of_nat(0x81).shift_left(1) == 2
  expect U8.of_nat(1).shift_left(8) == 0

  # The bits moved down by `amount`, those below the bottom lost.
  shift_right : (U8, Nat) -> U8
  shift_right(U8(a), amount) if amount < 8 -> U8(a / 2.pow(amount))
  shift_right(_, _) -> U8(0)
  expect U8.of_nat(0x81).shift_right(7) == 1

  # The bits moved up by `amount`, those past the top coming round to the
  # bottom. The width round is no change.
  rotate_left : (U8, Nat) -> U8
  rotate_left(U8(a), amount) -> (
    # The bits moved up, below the width, and those past it, above.
    moved = a * 2.pow(amount % 8)
    U8(moved % 256 + moved / 256)
  )
  expect U8.of_nat(0x81).rotate_left(1) == 3
  expect U8.of_nat(0x81).rotate_left(8) == 0x81

  rotate_right : (U8, Nat) -> U8
  rotate_right(word, amount) -> rotate_left(word, 8 - amount % 8)
  expect U8.of_nat(0x81).rotate_right(1) == 0xc0

  # How many of the word's bits are set, counted in place a pair, then a
  # nibble at a time: Hacker's Delight's count, with no loop.
  count_ones : U8 -> Nat
  count_ones(word) -> (
    pairs = word - (word.shift_right(1) & 0x55)
    nibbles = (pairs & 0x33) + (pairs.shift_right(2) & 0x33)
    ((nibbles + nibbles.shift_right(4)) & 0x0f).to_nat()
  )
  expect U8.of_nat(0).count_ones() == 0
  expect U8.of_nat(0x80).count_ones() == 1
  expect U8.of_nat(0xff).count_ones() == 8
  expect U8.of_nat(0x58).count_ones() == 3

  # How many bits are clear below the lowest set one, which is its index.
  # Nought has none set, so all 8 are clear: the width. Taking one borrows
  # from the lowest set bit, setting every bit below it, and those are the
  # ones `word` has clear.
  trailing_zeros : U8 -> Nat
  trailing_zeros(word) -> count_ones(!word & (word - 1))
  expect U8.of_nat(0).trailing_zeros() == 8
  expect U8.of_nat(1).trailing_zeros() == 0
  expect U8.of_nat(0x80).trailing_zeros() == 7
  expect U8.of_nat(0xff).trailing_zeros() == 0
  expect U8.of_nat(0x58).trailing_zeros() == 3

  # How many bits are clear above the highest set one. Nought has none set,
  # so all 8 are clear: the width. The highest set bit is copied into
  # every place below it, and the ones then counted.
  leading_zeros : U8 -> Nat
  leading_zeros(word) -> (
    pairs = word | word.shift_right(1)
    nibbles = pairs | pairs.shift_right(2)
    8 - count_ones(nibbles | nibbles.shift_right(4))
  )
  expect U8.of_nat(0).leading_zeros() == 8
  expect U8.of_nat(1).leading_zeros() == 7
  expect U8.of_nat(0x80).leading_zeros() == 0
  expect U8.of_nat(0xff).leading_zeros() == 0
  expect U8.of_nat(0x58).leading_zeros() == 1

  # `n` as a byte when it fits, and a refusal when it does not: the
  # checked narrowing, for values worked out at run time.
  from_nat : Nat -> Result(U8, [TooBig])
  from_nat(n) if n < 0x100 -> Ok(of_nat(n))
  from_nat(_) -> Err(TooBig)
  expect U8.from_nat(255) == Ok(255)
  expect U8.from_nat(256) == Err(TooBig)

  # `base` raised to the `exponent`-th power, modulo 256, by
  # `Nat.pow_mod`, so no intermediate grows past the ring.
  pow : (U8, Nat) -> U8
  pow(U8(base), exponent) -> U8(base.pow_mod(exponent, 256))
  expect U8.of_nat(3).pow(5) == 243
  expect U8.of_nat(3).pow(6) == 217

  # `hasher` with `a` fed: widened to a word.
  hash_into : (U8, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(U64.of_nat(to_nat(a)))
)

expect !'/'.is_digit() & !':'.is_digit()
expect !'@'.is_ascii_letter() & !'['.is_ascii_letter()
